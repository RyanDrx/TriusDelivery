---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Hero from '@components/Hero.astro';
import Cta from '@components/Cta.astro';
import { graphServices } from '../lib/schema.ts';
import WaveClip from '@components/WaveClip.astro';
import { Icon } from 'astro-icon/components';

const ctaData = {
    _type: 'ctaSection',
    heading: 'Ready to Partner with Trius for Your Medical Logistics?',
    body: 'When you need a dependable medical courier, Trius is here to help. By partnering with Trius, you gain a trusted logistics partner who ensures every delivery is safe, accurate, compliant, and on time.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Request Custom Quote',
            url: '/contact',
            theme: 'primary'
        },
        {
            _key: '2',
            _type: 'actionLink',
            label: 'View Coverage Areas',
            url: '/coverage'
        },
        {
            _key: '3',
            _type: 'actionLink',
            label: 'Learn About Our Company',
            url: '/about'
        }
    ]
};

const serviceUseCases = [
    {
        title: 'Hospitals and health systems',
        body: 'Facility-to-facility transfers, urgent deliveries, specimen movement, and support for patient-care timelines.'
    },
    {
        title: 'Laboratories and diagnostic centers',
        body: 'Routine pickups, STAT runs, and controlled transport for samples, kits, and testing materials.'
    },
    {
        title: 'Clinics and surgery centers',
        body: 'Reliable scheduled routes and time-specific handoffs for instruments, supplies, and case support items.'
    },
    {
        title: 'Medical device and specialty care teams',
        body: 'Direct handoff support for equipment, implants, diagnostic devices, and sensitive deliveries that cannot be treated like parcel freight.'
    }
];

const shipmentTypes = [
    'Medical specimens, samples, and bloodwork',
    'Pathology materials and test kits',
    'Pharmaceuticals and temperature-sensitive deliveries',
    'Surgical instruments and implant support materials',
    'Diagnostic devices and fragile medical equipment',
    'Interoffice healthcare mail runs and supply transfers',
    'Research materials and lab support shipments',
    'Urgent same-day medical courier requests'
];

const schema = graphServices();
---

<Layout
    title="Medical Courier Services for Hospitals, Labs and Clinics | Trius LLC"
    description="Medical courier services for hospitals, labs, and clinics. STAT specimen delivery, scheduled routes, and equipment transport in WA, OR, ID, MT, and CA."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="Medical Courier Services for Hospitals, Labs and Clinics | Trius LLC"
            description="Medical courier services for hospitals, labs, and clinics. STAT specimen delivery, scheduled routes, and equipment transport in WA, OR, ID, MT, and CA."
            graph={schema}
        />
        <link rel="preload" as="image" href="/Images/medical-equipment.webp" />
    </Fragment>

    <Hero
        backgroundImage="/Images/medical-equipment.webp"
        overlayClass="bg-gradient-to-r from-primary/80 via-primary/60 to-secondary/70"
        minHeight="min-h-[70vh]"
        useWaveClip={true}
    >
        <div class="text-center max-w-5xl mx-auto">
            <!-- Page Badge -->
            <div class="inline-flex items-center gap-3 mb-8 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <Icon name="material-symbols:medical-services" width="24" height="24" style="color: white;" />
                <span class="text-white font-bold tracking-wide uppercase">Professional Services</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-tight">Medical Courier Services</h1>

            <!-- Subtitle -->
            <div class="flex flex-wrap justify-center gap-4 mb-8 text-white/90 font-medium">
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:shield-check" width="20" height="20" />
                    Fully Compliant
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:truck" width="20" height="20" />
                    Specialized Equipment
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:map-pin" width="20" height="20" />
                    Real-Time Tracking
                </span>
            </div>

            <!-- Description -->
            <p class="text-xl lg:text-2xl text-white/90 mb-10 max-w-4xl mx-auto leading-relaxed">
                Comprehensive medical logistics solutions for hospitals, laboratories, clinics, surgery centers, and medical equipment
                providers across Washington, Oregon, Idaho, Montana, and California.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="/contact" class="btn btn-secondary btn-lg px-8 py-4 text-lg font-bold hover:scale-105 transition-all duration-300">
                    Get Quote Today
                </a>
                <a
                    href="/coverage"
                    class="text-white font-semibold hover:text-secondary-light transition-colors duration-300 flex items-center gap-2"
                >
                    View Coverage Areas
                    <Icon name="heroicons:arrow-right" width="20" height="20" />
                </a>
            </div>
        </div>
    </Hero>

    <!-- Main Services Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-16 lg:mb-20">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Comprehensive Medical Logistics Solutions</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Professional, compliant, and reliable courier services tailored for healthcare organizations and medical supply chains
                </p>
            </div>

            <div class="space-y-16 lg:space-y-20">
                <!-- STAT Deliveries -->
                <article class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-start pb-16 lg:pb-20 border-b border-slate-200">
                    <div>
                        <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-accent">
                            <Icon name="heroicons:clock" width="16" height="16" />
                            Emergency Service
                        </div>
                        <h3 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-5">STAT Deliveries</h3>
                        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
                            Rapid, secure, and compliant transport for specimens, bloodwork, pathology materials, organs, and urgent medical
                            devices. When time is critical, Trius STAT delivery provides immediate response with documented chain-of-custody
                            protocols and real-time tracking.
                        </p>

                        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-5 mb-10 max-w-2xl">
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:clock" width="18" height="18" class="text-accent mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Emergency Response</div>
                                    <p class="text-sm text-slate-600">Response within 30 minutes</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:map-pin" width="18" height="18" class="text-accent mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Real-Time Tracking</div>
                                    <p class="text-sm text-slate-600">Live GPS tracking updates</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:document-check" width="18" height="18" class="text-accent mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Chain-of-Custody</div>
                                    <p class="text-sm text-slate-600">Complete documentation</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:shield-check" width="18" height="18" class="text-accent mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Fully Compliant</div>
                                    <p class="text-sm text-slate-600">Full regulatory compliance</p>
                                </div>
                            </div>
                        </div>

                        <a href="/services/stat-delivery" class="group inline-flex items-center gap-2 text-sm font-bold text-accent hover:text-accent-dark transition-colors">
                            Learn More About STAT Delivery
                            <Icon name="heroicons:arrow-right" width="16" height="16" class="transition-transform group-hover:translate-x-0.5" />
                        </a>
                    </div>
                    <div class="lg:w-48 lg:pl-8 lg:border-l border-slate-200">
                        <div class="font-mono font-bold text-5xl lg:text-6xl text-accent leading-none tracking-tight">24/7</div>
                        <div class="mt-3 text-xs font-bold tracking-[0.16em] uppercase text-slate-500">Emergency Response</div>
                    </div>
                </article>

                <!-- Scheduled Routes -->
                <article class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-start pb-16 lg:pb-20 border-b border-slate-200">
                    <div>
                        <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-secondary-dark">
                            <Icon name="heroicons:calendar-days" width="16" height="16" />
                            Scheduled Service
                        </div>
                        <h3 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-5">Scheduled Routes</h3>
                        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
                            For organizations with predictable transport needs, our scheduled routes provide efficiency and consistency.
                            From daily specimen pickups and interoffice lab transfers to recurring supply deliveries, Trius builds routes
                            around your timeline.
                        </p>

                        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-5 mb-10 max-w-2xl">
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:calendar-days" width="18" height="18" class="text-secondary-dark mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Flexible Scheduling</div>
                                    <p class="text-sm text-slate-600">Daily, weekly, or monthly</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:user-group" width="18" height="18" class="text-secondary-dark mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Dedicated Couriers</div>
                                    <p class="text-sm text-slate-600">Consistent assignments</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:map" width="18" height="18" class="text-secondary-dark mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Route Optimization</div>
                                    <p class="text-sm text-slate-600">Technology-driven efficiency</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:currency-dollar" width="18" height="18" class="text-secondary-dark mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Cost-Effective</div>
                                    <p class="text-sm text-slate-600">Bulk transport pricing</p>
                                </div>
                            </div>
                        </div>

                        <a href="/services/scheduled-routes" class="group inline-flex items-center gap-2 text-sm font-bold text-secondary-dark hover:text-secondary transition-colors">
                            Learn More About Scheduled Routes
                            <Icon name="heroicons:arrow-right" width="16" height="16" class="transition-transform group-hover:translate-x-0.5" />
                        </a>
                    </div>
                    <div class="lg:w-48 lg:pl-8 lg:border-l border-slate-200">
                        <div class="font-mono font-bold text-5xl lg:text-6xl text-secondary-dark leading-none tracking-tight">Daily</div>
                        <div class="mt-3 text-xs font-bold tracking-[0.16em] uppercase text-slate-500">Reliable Routes</div>
                    </div>
                </article>

                <!-- Specialized Equipment Transport -->
                <article class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-start">
                    <div>
                        <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-primary">
                            <Icon name="heroicons:beaker" width="16" height="16" />
                            Specialized Service
                        </div>
                        <h3 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-5">Specialized Equipment Transport</h3>
                        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
                            Transporting fragile or regulated medical equipment requires special expertise. Our couriers are trained in
                            handling sensitive devices, biohazard materials, and temperature-controlled shipments.
                        </p>

                        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-5 mb-10 max-w-2xl">
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:beaker" width="18" height="18" class="text-primary mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Temperature Control</div>
                                    <p class="text-sm text-slate-600">Climate-controlled transport</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:shield-exclamation" width="18" height="18" class="text-primary mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Hazmat Certified</div>
                                    <p class="text-sm text-slate-600">Certified drivers</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:cube" width="18" height="18" class="text-primary mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Custom Packaging</div>
                                    <p class="text-sm text-slate-600">Specialized solutions</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon name="heroicons:document-text" width="18" height="18" class="text-primary mt-1 shrink-0" />
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">Full Insurance</div>
                                    <p class="text-sm text-slate-600">Comprehensive coverage</p>
                                </div>
                            </div>
                        </div>

                        <a href="/services/specialized-equipment" class="group inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-dark transition-colors">
                            Learn More About Equipment Transport
                            <Icon name="heroicons:arrow-right" width="16" height="16" class="transition-transform group-hover:translate-x-0.5" />
                        </a>
                    </div>
                    <div class="lg:w-48 lg:pl-8 lg:border-l border-slate-200">
                        <div class="font-mono font-bold text-5xl lg:text-6xl text-primary leading-none tracking-tight">100%</div>
                        <div class="mt-3 text-xs font-bold tracking-[0.16em] uppercase text-slate-500">Secure Transport</div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Why Choose Trius Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Why Choose Trius LLC?</h2>
                <p class="text-lg text-slate-600 leading-relaxed">More than a courier. We are your long-term logistics partner.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-12">
                <div>
                    <Icon name="heroicons:shield-check" width="28" height="28" class="text-primary mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Accuracy & Safety</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Every courier is rigorously trained to prevent misdeliveries and protect specimen integrity. Our documented procedures ensure safe, on-time delivery.
                    </p>
                </div>
                <div>
                    <Icon name="heroicons:clock" width="28" height="28" class="text-secondary-dark mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Reliability & Readiness</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Always on-call, 24/7, for both scheduled and urgent deliveries. When healthcare organizations need dependable logistics, Trius delivers.
                    </p>
                </div>
                <div>
                    <Icon name="heroicons:academic-cap" width="28" height="28" class="text-accent mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Expertise & Professionalism</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Experienced professionals oversee shipments with precision and courtesy. Our team understands the critical nature of medical logistics.
                    </p>
                </div>
                <div>
                    <Icon name="material-symbols:lightbulb-2-outline" width="28" height="28" class="text-primary mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Innovative Solutions</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Technology-driven logistics with optimized routes and proactive communication. We embrace complex challenges with cutting-edge solutions.
                    </p>
                </div>
                <div>
                    <Icon name="material-symbols:handshake-outline-sharp" width="28" height="28" class="text-secondary-dark mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Partnership Approach</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        We build lasting partnerships that create mutual success. Tailoring logistics solutions to meet your unique organizational needs.
                    </p>
                </div>
                <div>
                    <Icon name="heroicons:document-check" width="28" height="28" class="text-accent mb-4" />
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Compliance Excellence</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        We prioritize regulatory compliance and continuous training to stay ahead of industry standards.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Compliance Section -->
    <section class="py-20 lg:py-24 relative overflow-hidden bg-white">
        <!-- Desktop WaveClip Background -->
        <WaveClip
            side="both"
            amplitude={1.5}
            baseline={95}
            waves={1.5}
            phase={0}
            samples={36}
            class="absolute inset-0 py-24 hidden lg:block"
        >
            <div
                class="absolute inset-0 min-h-44"
                style='background-image: url("/Images/medical-vials.webp"); background-size: cover; background-repeat: no-repeat; background-position: center;'
            >
            </div>
            <div class="absolute inset-0 bg-white/90"></div>
        </WaveClip>

        <div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10 py-12 lg:py-20">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Compliance & Safety Standards</h2>
                <p class="text-lg text-slate-600 leading-relaxed">Absolute regulatory adherence for healthcare logistics</p>
            </div>

            <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
                <div class="bg-white border border-slate-200 rounded-2xl p-8">
                    <Icon name="heroicons:shield-check" width="32" height="32" class="text-primary mb-5" />
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Secure Handling</h3>
                    <p class="text-sm text-slate-600 leading-relaxed mb-6">
                        Secure handling of all protected health information and medical specimens. We maintain a strict 'no PHI collection' policy.
                    </p>
                    <ul class="space-y-2.5">
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-primary mt-1 shrink-0" />
                            <span>Secure handling of protected health information</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-primary mt-1 shrink-0" />
                            <span>Privacy protection protocols at every step</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-primary mt-1 shrink-0" />
                            <span>No PHI collection in digital communications</span>
                        </li>
                    </ul>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-8">
                    <Icon name="heroicons:academic-cap" width="32" height="32" class="text-secondary-dark mb-5" />
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Industry Trained</h3>
                    <p class="text-sm text-slate-600 leading-relaxed mb-6">
                        All drivers are trained in SetTrax and Casechek systems with ongoing certification in specimen handling and safe transport procedures.
                    </p>
                    <ul class="space-y-2.5">
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-secondary-dark mt-1 shrink-0" />
                            <span>SetTrax and Casechek certified</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-secondary-dark mt-1 shrink-0" />
                            <span>Ongoing safety training</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-secondary-dark mt-1 shrink-0" />
                            <span>Proper specimen handling protocols</span>
                        </li>
                    </ul>
                </div>
                <div class="bg-white border border-slate-200 rounded-2xl p-8">
                    <Icon name="heroicons:document-text" width="32" height="32" class="text-accent mb-5" />
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Insured & Bonded</h3>
                    <p class="text-sm text-slate-600 leading-relaxed mb-6">
                        Comprehensive insurance coverage and bonding for complete protection. State-of-the-art logistics technology with rigorous chain of custody procedures.
                    </p>
                    <ul class="space-y-2.5">
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-accent mt-1 shrink-0" />
                            <span>Full insurance coverage for all shipments</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-accent mt-1 shrink-0" />
                            <span>Bonded courier services</span>
                        </li>
                        <li class="flex items-start gap-2.5 text-sm text-slate-700">
                            <Icon name="heroicons:check" width="16" height="16" class="text-accent mt-1 shrink-0" />
                            <span>Chain of custody documentation</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Coverage Area Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Service Coverage Areas</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Comprehensive medical logistics across the Pacific Northwest & California
                </p>
            </div>

            <div class="grid lg:grid-cols-[1fr_1fr] gap-12 lg:gap-16 items-start">
                <div>
                    <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-primary">
                        <Icon name="heroicons:map" width="16" height="16" />
                        Regional Coverage
                    </div>

                    <h3 class="text-2xl md:text-3xl font-bold text-slate-900 tracking-tight leading-tight mb-5">Five-State Service Network</h3>

                    <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-8 max-w-lg">
                        Trius proudly serves healthcare organizations across the Pacific Northwest and California. With deep local knowledge
                        and growing regional coverage, we provide dependable in-state and cross-state deliveries.
                    </p>

                    <div class="rounded-2xl bg-white border border-slate-200 p-6">
