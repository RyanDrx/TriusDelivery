---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import { graphThanks } from '../lib/schema.ts';

const schema = graphThanks();
---

<Layout
    title="Request Received | Trius LLC"
    description="Your medical courier quote request was received. Trius LLC will respond within 24 hours."
>
    <Fragment slot="head">
        <SEO
            title="Request Received | Trius LLC"
            description="Your medical courier quote request was received. Trius LLC will respond within 24 hours."
            graph={schema}
            noindex
        />
    </Fragment>

    <section class="relative bg-white py-20 lg:py-28 min-h-[80vh] flex items-center overflow-hidden">
        <!-- Subtle brand accents -->
        <div
            aria-hidden="true"
            class="absolute -top-32 right-0 w-[40rem] h-[20rem] bg-[radial-gradient(ellipse_at_top_right,rgba(14,112,164,0.10),transparent_65%)] pointer-events-none"
        >
        </div>
        <div
            aria-hidden="true"
            class="absolute -bottom-32 left-0 w-[40rem] h-[20rem] bg-[radial-gradient(ellipse_at_bottom_left,rgba(95,168,67,0.10),transparent_65%)] pointer-events-none"
        >
        </div>

        <div class="relative max-w-3xl mx-auto px-6 lg:px-10">
            <!-- Confirmation mark -->
            <div class="flex items-center gap-3 text-[0.7rem] font-mono font-bold uppercase tracking-[0.26em] text-secondary-dark mb-8">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-secondary/15 ring-1 ring-secondary/25">
                    <iconify-icon icon="heroicons:check" width="18" height="18" class="text-secondary-dark" />
                </span>
                <span>Request received</span>
            </div>

            <!-- Headline -->
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.05]">
                Thanks. We've got it.
            </h1>

            <p class="mt-6 text-lg lg:text-xl text-slate-600 leading-relaxed max-w-2xl">
                Your quote request is in. A real person will review it and reply within
                <span class="font-semibold text-slate-900">24 hours</span>, usually faster. Check your inbox for a
                confirmation, and tell your spam folder it's friendly.
            </p>

            <!-- STAT urgency card -->
            <div class="mt-10 flex flex-col sm:flex-row items-start gap-5 rounded-2xl border border-accent/25 bg-accent/[0.04] p-6 lg:p-7">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent shadow-md shadow-accent/20 shrink-0">
                    <iconify-icon icon="heroicons:bolt" width="22" height="22" class="text-white" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 font-mono text-[0.65rem] font-bold tracking-[0.24em] uppercase text-accent">
                        <span class="relative flex h-2 w-2" aria-hidden="true">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-70"
                            ></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
                        </span>
                        Need it now?
                    </div>
                    <p class="mt-2 text-base text-slate-700 leading-relaxed">
                        STAT pickups can't wait on email. Call the 24/7 STAT line and we'll dispatch.
                    </p>
                    <a
                        href="tel:+12532310615"
                        class="mt-3 inline-flex items-center gap-2 text-xl font-bold text-slate-900 hover:text-accent transition-colors"
                    >
                        <iconify-icon icon="heroicons:phone" width="20" height="20" />
                        (253) 231-0615
                    </a>
                </div>
            </div>

            <!-- What happens next -->
            <div class="mt-12 pt-10 border-t border-slate-200">
                <div
                    class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-primary mb-6"
                >
                    <span class="h-px w-8 bg-primary/40"></span>
                    What happens next
                </div>
                <ol class="space-y-5">
                    {
                        [
                            'A Trius dispatcher reviews your request and matches it to the right service mix.',
                            'You get a quote tied to your actual volume, not a pricing calculator. No surge fees, no after-hours markups.',
                            'Once you approve, we set up the route or schedule the first pickup. Usually same-day or next-day for non-STAT requests.'
                        ].map((step, idx) => (
                            <li class="flex gap-5">
                                <span class="font-mono text-2xl font-bold text-primary tabular-nums leading-none shrink-0 w-10">
                                    {String(idx + 1).padStart(2, '0')}
                                </span>
                                <p class="text-base lg:text-lg text-slate-700 leading-relaxed">{step}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>

            <!-- Secondary links -->
            <div class="mt-12 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
                <a
                    href="/"
                    class="inline-flex items-center gap-1.5 text-slate-900 hover:text-primary transition-colors group/link"
                >
                    <iconify-icon icon="heroicons:arrow-left" width="14" height="14" class="transition-transform duration-200 group-hover/link:-translate-x-0.5" />
                    Back home
                </a>
                <span class="text-slate-300">/</span>
                <a
                    href="/services"
                    class="inline-flex items-center gap-1.5 text-slate-600 hover:text-slate-900 transition-colors"
                >
                    Browse services
                </a>
                <span class="text-slate-300">/</span>
                <a
                    href="/coverage"
                    class="inline-flex items-center gap-1.5 text-slate-600 hover:text-slate-900 transition-colors"
                >
                    Coverage map
                </a>
                <span class="text-slate-300">/</span>
                <a
                    href="/about"
                    class="inline-flex items-center gap-1.5 text-slate-600 hover:text-slate-900 transition-colors"
                >
                    Who we are
                </a>
            </div>
        </div>
    </section>
</Layout>
