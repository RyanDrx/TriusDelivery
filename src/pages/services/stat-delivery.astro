---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Hero from '@components/Hero.astro';
import Cta from '@components/Cta.astro';
import { graphServiceStat } from '../../lib/schema.ts';

const featuresData = {
    items: [
        {
            heading: 'Emergency Response',
            body: 'Response within 30 minutes for urgent medical specimen and equipment deliveries with priority dispatch.',
            icon: 'mdi:clock-fast',
            color: 'accent',
            features: ['24/7 dispatch availability', '30-minute response time', 'Priority routing system']
        },
        {
            heading: 'Chain of Custody',
            body: 'Complete documentation and verification at every step to ensure specimen integrity and regulatory compliance.',
            icon: 'mdi:clipboard-check',
            color: 'primary',
            features: ['Digital signature capture', 'Barcode tracking system', 'Compliance documentation']
        },
        {
            heading: 'Real-Time Tracking',
            body: 'GPS tracking and automated notifications keep you informed throughout the entire delivery process.',
            icon: 'mdi:radar',
            color: 'secondary',
            features: ['GPS location tracking', 'Automated notifications', 'Live delivery updates']
        }
    ]
};

const processSteps = [
    {
        heading: '1. Emergency Call',
        body: 'Call our 24/7 STAT line with your urgent delivery requirements. Our dispatch team will immediately assess and assign a courier.',
        icon: 'mdi:phone-alert'
    },
    {
        heading: '2. Rapid Dispatch',
        body: 'Within 30 minutes, a certified courier will arrive at the pickup location with appropriate handling equipment.',
        icon: 'mdi:truck-fast'
    },
    {
        heading: '3. Secure Transport',
        body: 'Temperature-controlled, secure transport with real-time tracking and chain-of-custody documentation.',
        icon: 'mdi:shield-lock'
    },
    {
        heading: '4. Verified Delivery',
        body: 'Digital signature confirmation and immediate notification to all parties upon successful delivery.',
        icon: 'mdi:check-circle'
    }
];

const handlingTypes = [
    { heading: 'Medical Specimens', body: 'Blood, urine, tissue samples with temperature control', icon: 'mdi:test-tube', color: 'accent' },
    { heading: 'Organs & Tissue', body: 'Time-critical organ transport with specialized handling', icon: 'mdi:heart', color: 'primary' },
    { heading: 'Pharmaceuticals', body: 'Controlled substances and temperature-sensitive medications', icon: 'mdi:pill', color: 'secondary' },
    { heading: 'Medical Equipment', body: 'Urgent delivery of critical medical devices and supplies', icon: 'mdi:medical-bag', color: 'accent' }
];

const ctaData = {
    _type: 'ctaSection',
    heading: 'Need Emergency STAT Delivery?',
    body: 'Our 24/7 STAT service is ready to handle your urgent medical courier needs. Contact us now for immediate dispatch.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Call STAT Line',
            url: 'tel:+12532310615',
            theme: 'accent'
        },
        {
            _key: '2',
            _type: 'actionButton',
            label: 'Request Quote',
            url: '/contact?service=stat',
            theme: 'primary'
        }
    ]
};

const schema = graphServiceStat();
---

<Layout
    title="STAT Medical Courier Deliveries | Trius LLC"
    description="Rapid STAT medical courier transport for specimens, bloodwork, organs, pharmaceuticals, and critical medical equipment with chain of custody and real-time tracking. 24/7 emergency service."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="STAT Medical Courier Deliveries | Trius LLC"
            description="Rapid STAT medical courier transport for specimens, bloodwork, organs, pharmaceuticals, and critical medical equipment with chain of custody and real-time tracking. 24/7 emergency service."
            graph={schema}
        />
        <link rel="preload" as="image" href="/Images/medical-vials.webp" />
    </Fragment>

    <Hero
        backgroundImage="/Images/medical-vials.webp"
        overlayClass="bg-gradient-to-r from-accent/80 via-accent/60 to-primary/70"
        minHeight="min-h-[70vh]"
        useWaveClip={true}
    >
        <div class="text-center max-w-5xl mx-auto">
            <!-- Page Badge -->
            <div class="inline-flex items-center gap-3 mb-8 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <iconify-icon icon="heroicons:bolt" width="24" height="24" style="color: white;"></iconify-icon>
                <span class="text-white font-bold tracking-wide uppercase">Emergency Service</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-tight">STAT Medical Courier Deliveries</h1>

            <!-- Subtitle -->
            <div class="flex flex-wrap justify-center gap-4 mb-8 text-white/90 font-medium">
                <span class="flex items-center gap-2">
                    <iconify-icon icon="heroicons:clock" width="20" height="20"></iconify-icon>
                    30-Minute Response
                </span>
                <span class="flex items-center gap-2">
                    <iconify-icon icon="heroicons:shield-check" width="20" height="20"></iconify-icon>
                    Chain of Custody
                </span>
                <span class="flex items-center gap-2">
                    <iconify-icon icon="heroicons:map-pin" width="20" height="20"></iconify-icon>
                    Real-Time Tracking
                </span>
            </div>

            <!-- Description -->
            <p class="text-xl lg:text-2xl text-white/90 mb-10 max-w-4xl mx-auto leading-relaxed">
                Rapid, secure, and compliant transport for specimens, bloodwork, organs, pharmaceuticals, and urgent medical devices. When
                time is critical, our STAT delivery service provides immediate response with documented chain-of-custody protocols.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a
                    href="/contact?service=stat"
                    class="btn btn-accent btn-lg px-8 py-4 text-lg font-bold hover:scale-105 transition-all duration-300"
                >
                    Request STAT Service
                </a>
                <a
                    href="tel:+12532310615"
                    class="text-white font-semibold hover:text-accent-light transition-colors duration-300 flex items-center gap-2"
                >
                    Call Emergency Line
                    <iconify-icon icon="heroicons:phone" width="20" height="20"></iconify-icon>
                </a>
            </div>
        </div>
    </Hero>

    <!-- What is STAT Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14">
                <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-accent">
                    <iconify-icon icon="mdi:medical-cross" width="16" height="16"></iconify-icon>
                    Medical Terminology
                </div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-6">What is STAT?</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    <strong class="text-slate-900">STAT</strong> is a medical term derived from the Latin word "statim," meaning "immediately" or "at once." In medical
                    logistics, STAT indicates the highest level of urgency for specimen transport, diagnostic testing, and medical equipment delivery.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">
                <div>
                    <iconify-icon icon="mdi:clock-alert" width="28" height="28" class="text-accent mb-4"></iconify-icon>
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Immediate Response</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        STAT orders require immediate attention and response, typically within 30 minutes or less. This urgency is critical for
                        time-sensitive medical procedures and emergency situations.
                    </p>
                </div>

                <div>
                    <iconify-icon icon="mdi:medical-bag" width="28" height="28" class="text-primary mb-4"></iconify-icon>
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Medical Priority</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        STAT deliveries take precedence over all other non-emergency medical courier services. They are essential for critical
                        patient care, organ transplants, and emergency diagnostics.
                    </p>
                </div>

                <div>
                    <iconify-icon icon="mdi:certificate" width="28" height="28" class="text-secondary-dark mb-4"></iconify-icon>
                    <h3 class="text-lg font-bold text-slate-900 mb-3">Regulatory Compliance</h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        STAT deliveries must meet strict regulatory requirements including chain of custody, temperature monitoring, and
                        documentation standards for medical specimen integrity.
                    </p>
                </div>
            </div>

            <!-- Decision Guide -->
            <div class="mt-16 lg:mt-20 rounded-2xl border border-slate-200 overflow-hidden bg-white">
                <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
                    <div class="bg-primary-dark text-white px-8 py-10 lg:px-10 lg:py-12">
                        <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.18em] uppercase text-secondary-light">
                            <iconify-icon icon="mdi:alarm-light" width="16" height="16"></iconify-icon>
                            Decision Guide
                        </div>
                        <h4 class="text-2xl lg:text-3xl font-bold tracking-tight leading-tight mb-5">When to Use STAT Delivery</h4>
                        <p class="text-base lg:text-lg text-white/80 leading-relaxed max-w-xl">
                            Use STAT service when a delay creates clinical risk, disrupts treatment, or compromises specimen integrity. If the item
                            cannot wait for a scheduled run, it belongs in an immediate-response workflow.
                        </p>

                        <div class="mt-8 space-y-5 pt-6 border-t border-white/15">
                            <div>
                                <div class="text-xs font-bold uppercase tracking-[0.16em] text-secondary-light mb-2">Request STAT When</div>
                                <div class="text-base text-white">The delivery decision is tied to patient care, diagnosis, or procedure timing.</div>
                            </div>
                            <div class="pt-5 border-t border-white/15">
                                <div class="text-xs font-bold uppercase tracking-[0.16em] text-secondary-light mb-2">Avoid Routine Routing When</div>
                                <div class="text-base text-white">A missed pickup window would force re-draws, treatment delays, or equipment downtime.</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-50 px-8 py-10 lg:px-10 lg:py-12">
                        <div class="grid sm:grid-cols-2 gap-5">
                            <div>
                                <div class="flex items-center justify-between gap-3 mb-3">
                                    <h5 class="text-base font-bold text-slate-900">Critical Specimens</h5>
                                    <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent">Immediate</span>
                                </div>
                                <p class="text-sm leading-6 text-slate-600">
                                    Time-sensitive blood, tissue, or diagnostic samples that must reach the lab without compromising turnaround or viability.
                                </p>
                            </div>

                            <div>
                                <div class="flex items-center justify-between gap-3 mb-3">
                                    <h5 class="text-base font-bold text-slate-900">Organs and Tissue</h5>
                                    <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary">Time Critical</span>
                                </div>
                                <p class="text-sm leading-6 text-slate-600">
                                    Transplant-related transport where every minute affects coordination, viability, and the downstream care team.
                                </p>
                            </div>

                            <div>
                                <div class="flex items-center justify-between gap-3 mb-3">
                                    <h5 class="text-base font-bold text-slate-900">Urgent Equipment</h5>
                                    <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-secondary-dark">Operational</span>
                                </div>
                                <p class="text-sm leading-6 text-slate-600">
                                    Medical devices, pumps, or specialty components needed to keep procedures on schedule or restore clinical operations.
                                </p>
                            </div>

                            <div>
                                <div class="flex items-center justify-between gap-3 mb-3">
                                    <h5 class="text-base font-bold text-slate-900">Pharma and Supplies</h5>
                                    <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-red-700">Patient Impact</span>
                                </div>
                                <p class="text-sm leading-6 text-slate-600">
                                    Emergency pharmaceuticals or life-saving supplies needed to prevent treatment interruption or escalation of care.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">STAT Delivery Features</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our STAT delivery service is designed for the most critical medical logistics needs with specialized handling and rapid response.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
                {
                    featuresData.items.map((item) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <iconify-icon
                                icon={item.icon}
                                width="28"
                                height="28"
                                class:list={[
                                    'mb-4 shrink-0',
                                    item.color === 'accent' && 'text-accent',
                                    item.color === 'primary' && 'text-primary',
                                    item.color === 'secondary' && 'text-secondary-dark'
                                ]}
                            />
                            <h3 class="text-lg font-bold text-slate-900 mb-3">{item.heading}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed mb-5">{item.body}</p>
                            <ul class="space-y-2 pt-5 border-t border-slate-200">
                                {item.features.map((f) => (
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <iconify-icon
                                            icon="heroicons:check"
                                            width="14"
                                            height="14"
                                            class:list={[
                                                'mt-1 shrink-0',
                                                item.color === 'accent' && 'text-accent',
                                                item.color === 'primary' && 'text-primary',
                                                item.color === 'secondary' && 'text-secondary-dark'
                                            ]}
                                        />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">STAT Delivery Process</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our streamlined process ensures rapid response and secure handling for urgent medical deliveries.
                </p>
            </div>

            <ol class="space-y-10">
                {
                    processSteps.map((step, idx) => (
                        <li class:list={['grid grid-cols-[3rem_1fr] gap-x-6 items-start', idx > 0 && 'pt-10 border-t border-slate-200']}>
                            <iconify-icon icon={step.icon} width="32" height="32" class="text-accent mt-1"></iconify-icon>
                            <div>
                                <h3 class="text-xl md:text-2xl font-bold text-slate-900 tracking-tight leading-snug mb-2">{step.heading}</h3>
                                <p class="text-base text-slate-600 leading-relaxed max-w-2xl">{step.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <!-- Specialized Handling Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Specialized Handling Capabilities</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our STAT delivery service includes specialized handling for various types of medical materials and equipment.
                </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                {
                    handlingTypes.map((h) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-6">
                            <iconify-icon
                                icon={h.icon}
                                width="32"
                                height="32"
                                class:list={[
                                    'mb-4',
                                    h.color === 'accent' && 'text-accent',
                                    h.color === 'primary' && 'text-primary',
                                    h.color === 'secondary' && 'text-secondary-dark'
                                ]}
                            />
                            <h4 class="font-bold text-slate-900 mb-2">{h.heading}</h4>
                            <p class="text-sm text-slate-600 leading-relaxed">{h.body}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <Cta {...ctaData} />

    <!-- Related Services -->
    <section class="py-16 lg:py-20 bg-white border-t border-slate-200">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <h2 class="text-xl font-bold text-slate-900 mb-8">Explore Our Other Services</h2>
            <div class="grid sm:grid-cols-2 gap-x-12 gap-y-6">
                <a href="/services/scheduled-routes" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-secondary-dark transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-secondary-dark transition-colors mb-1">Scheduled Routes</h3>
                        <p class="text-sm text-slate-600">Recurring pickups and deliveries for clinics, labs, and research centers with route optimization.</p>
                    </div>
                    <iconify-icon icon="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-secondary-dark mt-1.5 transition-colors"></iconify-icon>
                </a>
                <a href="/services/specialized-equipment" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-primary transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-primary transition-colors mb-1">Specialized Equipment Transport</h3>
                        <p class="text-sm text-slate-600">Secure delivery of fragile medical devices with trained handlers and temperature control.</p>
                    </div>
                    <iconify-icon icon="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-primary mt-1.5 transition-colors"></iconify-icon>
                </a>
            </div>
        </div>
    </section>
</Layout>
