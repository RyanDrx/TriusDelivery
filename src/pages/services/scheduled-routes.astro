---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Hero from '@components/Hero.astro';
import Cta from '@components/Cta.astro';
import { graphServiceRoutes } from '../../lib/schema.ts';
import { Icon } from 'astro-icon/components';

const benefits = [
    {
        heading: 'Cost Efficiency',
        body: 'Optimize your logistics budget with scheduled routes that reduce per-delivery costs through bulk transport and route efficiency.',
        icon: 'mdi:currency-usd',
        color: 'primary',
        features: ['Volume discounts available', 'Predictable monthly costs', 'Route optimization savings']
    },
    {
        heading: 'Reliability',
        body: 'Consistent pickup and delivery times with dedicated courier assignments ensure your operations run smoothly.',
        icon: 'mdi:clock-check',
        color: 'accent',
        features: ['Dedicated courier teams', 'Guaranteed time windows', 'Backup coverage available']
    },
    {
        heading: 'Flexibility',
        body: 'Adapt your routes as your needs change with flexible scheduling options and route modifications.',
        icon: 'mdi:calendar-edit',
        color: 'secondary',
        features: ['Multiple frequency options', 'Easy route modifications', 'Holiday schedule adjustments']
    }
];

const routeTypes = [
    {
        heading: 'Daily Routes',
        body: 'Monday through Friday daily pickups and deliveries for high-volume facilities requiring frequent service.',
        icon: 'mdi:calendar-today',
        color: 'primary',
        features: ['Morning and afternoon options', 'Same-day turnaround available', 'Priority handling for urgent items']
    },
    {
        heading: 'Weekly Routes',
        body: 'One to three times per week service ideal for medium-volume facilities with predictable logistics needs.',
        icon: 'mdi:calendar-week',
        color: 'secondary',
        features: ['Flexible day selection', 'Consistent weekly schedule', 'Cost-effective for medium volume']
    },
    {
        heading: 'Bi-Weekly Routes',
        body: 'Every other week service for lower-volume facilities or specialized research materials with longer processing times.',
        icon: 'mdi:calendar-month',
        color: 'accent',
        features: ['Perfect for research facilities', 'Lower volume optimization', 'Extended processing accommodation']
    },
    {
        heading: 'Custom Routes',
        body: 'Tailored routing solutions for unique requirements, multi-location facilities, or specialized logistics needs.',
        icon: 'mdi:cog',
        color: 'neutral',
        features: ['Multi-stop optimization', 'Specialized handling integration', 'Custom timing requirements']
    }
];

const setupSteps = [
    { name: 'Needs Assessment', body: 'We analyze your volume, timing, and special requirements to design the optimal route.' },
    { name: 'Route Design', body: 'Our logistics team creates an optimized route plan with timing and pricing details.' },
    { name: 'Team Assignment', body: 'Dedicated courier team assignment ensures consistency and familiarity with your needs.' },
    { name: 'Service Launch', body: 'Route implementation with ongoing monitoring and optimization as your needs evolve.' }
];

const ctaData = {
    _type: 'ctaSection',
    heading: 'Ready to Optimize Your Medical Logistics?',
    body: 'Let us design a scheduled route solution that reduces costs and improves reliability for your medical courier needs.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Get Route Estimate',
            url: '/contact?service=routes',
            theme: 'primary'
        },
        {
            _key: '2',
            _type: 'actionLink',
            label: 'View Coverage Areas',
            url: '/coverage'
        }
    ]
};

const schema = graphServiceRoutes();
---

<Layout
    title="Scheduled Medical Courier Routes | Trius LLC"
    description="Cost-effective scheduled medical courier routes for clinics, hospitals, labs, pharmacies, and research centers. Recurring specimen pickups and deliveries with route optimization and reliable timing."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="Scheduled Medical Courier Routes | Trius LLC"
            description="Cost-effective scheduled medical courier routes for clinics, hospitals, labs, pharmacies, and research centers. Recurring specimen pickups and deliveries with route optimization and reliable timing."
            graph={schema}
        />
    </Fragment>

    <Hero
        backgroundImage="/Images/vehicle package.webp"
        overlayClass="bg-gradient-to-r from-secondary/80 via-secondary/60 to-primary/70"
        minHeight="min-h-[70vh]"
        useWaveClip={true}
    >
        <div class="text-center max-w-5xl mx-auto">
            <!-- Page Badge -->
            <div class="inline-flex items-center gap-3 mb-8 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <Icon name="heroicons:calendar-days" width="24" height="24" style="color: white;" />
                <span class="text-white font-bold tracking-wide uppercase">Scheduled Service</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-tight">Scheduled Medical Courier Routes</h1>

            <!-- Subtitle -->
            <div class="flex flex-wrap justify-center gap-4 mb-8 text-white/90 font-medium">
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:currency-dollar" width="20" height="20" />
                    Cost Effective
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:user-group" width="20" height="20" />
                    Dedicated Teams
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:map" width="20" height="20" />
                    Route Optimization
                </span>
            </div>

            <!-- Description -->
            <p class="text-xl lg:text-2xl text-white/90 mb-10 max-w-4xl mx-auto leading-relaxed">
                Recurring pickups and deliveries for clinics, hospitals, labs, pharmacies, and research centers. Our scheduled routes
                provide efficiency, consistency, and cost savings for regular specimen transport, supply transfers, and medical logistics.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a
                    href="/contact?service=routes"
                    class="btn btn-secondary btn-lg px-8 py-4 text-lg font-bold hover:scale-105 transition-all duration-300"
                >
                    Schedule Routes
                </a>
                <a
                    href="/coverage"
                    class="text-white font-semibold hover:text-secondary-light transition-colors duration-300 flex items-center gap-2"
                >
                    View Coverage Areas
                    <Icon name="heroicons:arrow-right" width="20" height="20" />
                </a>
            </div>
        </div>
    </Hero>

    <!-- Benefits Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Scheduled Route Benefits</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our scheduled route service provides predictable, cost-effective logistics for healthcare facilities that need regular specimen pickups, supply transfers, and recurring medical deliveries.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
                {
                    benefits.map((b) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <Icon
                                name={b.icon}
                                width="28"
                                height="28"
                                class:list={[
                                    'mb-4',
                                    b.color === 'primary' && 'text-primary',
                                    b.color === 'accent' && 'text-accent',
                                    b.color === 'secondary' && 'text-secondary-dark'
                                ]}
                            />
                            <h3 class="text-lg font-bold text-slate-900 mb-3">{b.heading}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed mb-5">{b.body}</p>
                            <ul class="space-y-2 pt-5 border-t border-slate-200">
                                {b.features.map((f) => (
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <Icon
                                            name="heroicons:check"
                                            width="14"
                                            height="14"
                                            class:list={[
                                                'mt-1 shrink-0',
                                                b.color === 'primary' && 'text-primary',
                                                b.color === 'accent' && 'text-accent',
                                                b.color === 'secondary' && 'text-secondary-dark'
                                            ]}
                                        />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Route Types Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Route Scheduling Options</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Choose from various scheduling options designed to meet different facility needs and logistics requirements.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
                {
                    routeTypes.map((r) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <Icon
                                name={r.icon}
                                width="28"
                                height="28"
                                class:list={[
                                    'mb-4',
                                    r.color === 'primary' && 'text-primary',
                                    r.color === 'accent' && 'text-accent',
                                    r.color === 'secondary' && 'text-secondary-dark',
                                    r.color === 'neutral' && 'text-slate-700'
                                ]}
                            />
                            <h3 class="text-lg font-bold text-slate-900 mb-3">{r.heading}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed mb-5">{r.body}</p>
                            <ul class="grid sm:grid-cols-1 gap-2 pt-5 border-t border-slate-200">
                                {r.features.map((f) => (
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <Icon
                                            name="heroicons:check"
                                            width="14"
                                            height="14"
                                            class:list={[
                                                'mt-1 shrink-0',
                                                r.color === 'primary' && 'text-primary',
                                                r.color === 'accent' && 'text-accent',
                                                r.color === 'secondary' && 'text-secondary-dark',
                                                r.color === 'neutral' && 'text-slate-500'
                                            ]}
                                        />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Setup Process Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Route Setup Process</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Getting started with scheduled routes is simple. Our logistics team works with you to design the optimal route for your needs.
                </p>
            </div>

            <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-10">
                {
                    setupSteps.map((step, idx) => (
                        <li>
                            <div class="font-mono font-bold text-3xl lg:text-4xl text-primary leading-none tracking-tight mb-4">
                                {String(idx + 1).padStart(2, '0')}
                            </div>
                            <h4 class="text-base font-bold text-slate-900 mb-2">{step.name}</h4>
                            <p class="text-sm text-slate-600 leading-relaxed">{step.body}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <Cta {...ctaData} />

    <!-- Related Services -->
    <section class="py-16 lg:py-20 bg-white border-t border-slate-200">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <h2 class="text-xl font-bold text-slate-900 mb-8">Explore Our Other Services</h2>
            <div class="grid sm:grid-cols-2 gap-x-12 gap-y-6">
                <a href="/services/stat-delivery" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-accent transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-accent transition-colors mb-1">STAT Deliveries</h3>
                        <p class="text-sm text-slate-600">Rapid, secure transport of specimens, organs, and urgent medical equipment with real-time tracking.</p>
                    </div>
                    <Icon name="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-accent mt-1.5 transition-colors" />
                </a>
                <a href="/services/specialized-equipment" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-primary transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-primary transition-colors mb-1">Specialized Equipment Transport</h3>
                        <p class="text-sm text-slate-600">Secure delivery of fragile medical devices with trained handlers and temperature control.</p>
                    </div>
                    <Icon name="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-primary mt-1.5 transition-colors" />
                </a>
            </div>
        </div>
    </section>
</Layout>
