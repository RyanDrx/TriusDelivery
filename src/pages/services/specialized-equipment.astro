---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Hero from '@components/Hero.astro';
import Cta from '@components/Cta.astro';
import WaveClip from '@components/WaveClip.astro';
import { graphServiceEquipment } from '../../lib/schema.ts';
import { Icon } from 'astro-icon/components';

const capabilities = [
    {
        heading: 'Temperature Control',
        body: 'Climate-controlled vehicles and specialized packaging for temperature-sensitive medical equipment and pharmaceuticals.',
        icon: 'mdi:thermometer',
        color: 'primary',
        features: ['Refrigerated transport (2-8°C)', 'Heated transport options', 'Temperature monitoring & logging']
    },
    {
        heading: 'Fragile Handling',
        body: 'Specialized training and equipment for transporting delicate medical instruments and sensitive diagnostic equipment.',
        icon: 'mdi:hand-heart',
        color: 'accent',
        features: ['Custom packaging solutions', 'Certified handling technicians', 'Shock & vibration protection']
    },
    {
        heading: 'Secure Transport',
        body: 'High-value equipment transport with enhanced security measures and comprehensive insurance coverage.',
        icon: 'mdi:shield-lock',
        color: 'secondary',
        features: ['Secure vehicle locks', 'GPS tracking & monitoring', 'Bonded & insured transport']
    }
];

const equipmentTypes = [
    {
        heading: 'Diagnostic Equipment',
        body: 'Precise handling of sensitive diagnostic instruments including analyzers, scanners, and testing equipment.',
        icon: 'mdi:monitor-dashboard',
        features: ['Laboratory analyzers', 'Portable X-ray equipment', 'Ultrasound machines', 'ECG/EKG equipment']
    },
    {
        heading: 'Surgical Instruments',
        body: 'Sterile transport of surgical instruments and specialized medical tools with contamination prevention.',
        icon: 'mdi:medical-bag',
        features: ['Sterile instrument sets', 'Robotic surgery components', 'Microsurgical instruments', 'Implantable devices']
    },
    {
        heading: 'Imaging Equipment',
        body: 'Large equipment transport including MRI components, CT scan parts, and other heavy medical imaging devices.',
        icon: 'mdi:image-multiple',
        features: ['MRI machine components', 'CT scanner parts', 'Mammography equipment', 'Digital radiography systems']
    },
    {
        heading: 'Laboratory Equipment',
        body: 'Specialized handling for laboratory instruments including centrifuges, microscopes, and analytical equipment.',
        icon: 'mdi:flask',
        features: ['High-speed centrifuges', 'Electron microscopes', 'Spectrophotometers', 'PCR machines']
    }
];

const safetyStandards = [
    {
        heading: 'Compliance Certifications',
        icon: 'mdi:certificate',
        color: 'primary',
        features: ['FDA regulations compliance', 'Privacy and transport requirements', 'Safety standards', 'DOT transportation regulations']
    },
    {
        heading: 'Staff Training',
        icon: 'mdi:school',
        color: 'accent',
        features: ['Equipment handling certification', 'Hazmat transport training', 'Clean room procedures', 'Emergency response protocols']
    },
    {
        heading: 'Insurance & Protection',
        icon: 'mdi:shield-check',
        color: 'secondary',
        features: ['Comprehensive cargo insurance', 'Equipment damage protection', 'Liability coverage', 'Transit risk management']
    }
];

const ctaData = {
    _type: 'ctaSection',
    heading: 'Need Specialized Equipment Transport?',
    body: 'Trust your valuable medical equipment to our trained professionals. Contact us for a customized transport solution.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Get Equipment Quote',
            url: '/contact?service=equipment',
            theme: 'primary'
        },
        {
            _key: '2',
            _type: 'actionButton',
            label: 'Call for Consultation',
            url: 'tel:+12532310615',
            theme: 'secondary'
        }
    ]
};

const schema = graphServiceEquipment();
---

<Layout
    title="Specialized Medical Equipment Transport | Trius LLC"
    description="Expert transport of fragile medical equipment, imaging systems, surgical instruments, and diagnostic devices with temperature control, secure handling, and specialized packaging."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="Specialized Medical Equipment Transport | Trius LLC"
            description="Expert transport of fragile medical equipment, imaging systems, surgical instruments, and diagnostic devices with temperature control, secure handling, and specialized packaging."
            graph={schema}
        />
    </Fragment>

    <Hero
        backgroundImage="/Images/medical monitor equip.webp"
        overlayClass="bg-gradient-to-r from-primary/80 via-primary/60 to-secondary/70"
        minHeight="min-h-[70vh]"
        useWaveClip={true}
        waveConfig={{
            side: 'bottom',
            amplitude: 1.5,
            baseline: 95,
            waves: 1.2,
            phase: 0,
            samples: 36
        }}
    >
        <div class="text-center max-w-5xl mx-auto">
            <!-- Page Badge -->
            <div class="inline-flex items-center gap-3 mb-8 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <Icon name="heroicons:cube" width="24" height="24" style="color: white;" />
                <span class="text-white font-bold tracking-wide uppercase">Specialized Service</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-tight">Specialized Medical Equipment Transport</h1>

            <!-- Subtitle -->
            <div class="flex flex-wrap justify-center gap-4 mb-8 text-white/90 font-medium">
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:beaker" width="20" height="20" />
                    Temperature Control
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:shield-exclamation" width="20" height="20" />
                    Hazmat Certified
                </span>
                <span class="flex items-center gap-2">
                    <Icon name="heroicons:truck" width="20" height="20" />
                    Specialized Vehicles
                </span>
            </div>

            <!-- Description -->
            <p class="text-xl lg:text-2xl text-white/90 mb-10 max-w-4xl mx-auto leading-relaxed">
                Expert handling of fragile medical equipment, temperature-sensitive devices, imaging components, and regulated materials.
                Our trained technicians use specialized vehicles and industry best practices to ensure safe delivery.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a
                    href="/contact?service=equipment"
                    class="btn btn-primary btn-lg px-8 py-4 text-lg font-bold hover:scale-105 transition-all duration-300"
                >
                    Get Equipment Quote
                </a>
                <a
                    href="tel:+12532310615"
                    class="text-white font-semibold hover:text-primary-light transition-colors duration-300 flex items-center gap-2"
                >
                    Call for Consultation
                    <Icon name="heroicons:phone" width="20" height="20" />
                </a>
            </div>
        </div>
    </Hero>

    <!-- Field Handling Intro Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-start">
                <div>
                    <div class="inline-flex items-center gap-2 mb-5 text-xs font-bold tracking-[0.16em] uppercase text-primary">
                        <Icon name="mdi:account-hard-hat" width="16" height="16" />
                        Field Handling
                    </div>
                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">
                        Real Equipment Handoffs Need More Than a Standard Courier Workflow
                    </h2>
                    <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-10 max-w-2xl">
                        Specialized equipment moves require trained handling, controlled transfer, and direct accountability at pickup and
                        delivery. This is the kind of handoff where condition, packaging, timing, and signoff all matter.
                    </p>

                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <div class="text-sm font-bold uppercase tracking-[0.14em] text-primary mb-3">Protected Transfer</div>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Sensitive components are moved with controlled handling instead of being treated like routine parcel freight.
                            </p>
                        </div>
                        <div>
                            <div class="text-sm font-bold uppercase tracking-[0.14em] text-secondary-dark mb-3">Chain of Responsibility</div>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                We maintain clear handoff points so facilities know exactly who received the equipment and when.
                            </p>
                        </div>
                    </div>
                </div>

                <figure class="lg:sticky lg:top-24">
                    <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 aspect-[4/5]">
                        <img
                            src="/handoff.webp"
                            alt="Trius team members coordinating a medical equipment handoff in a healthcare facility"
                            class="absolute top-1/2 left-1/2 block h-auto w-[135%] max-w-none -translate-x-1/2 -translate-y-1/2 rotate-90 transform"
                            loading="lazy"
                            decoding="async"
                            width="640"
                            height="480"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/45 via-transparent to-transparent"></div>
                    </div>
                </figure>
            </div>
        </div>
    </section>

    <!-- Capabilities Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Equipment Transport Capabilities</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our specialized equipment transport service handles delicate, regulated, and high-value medical devices with expert care, secure packaging, and documented handoff procedures.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
                {
                    capabilities.map((c) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <Icon
                                name={c.icon}
                                width="28"
                                height="28"
                                class:list={[
                                    'mb-4',
                                    c.color === 'primary' && 'text-primary',
                                    c.color === 'accent' && 'text-accent',
                                    c.color === 'secondary' && 'text-secondary-dark'
                                ]}
                            />
                            <h3 class="text-lg font-bold text-slate-900 mb-3">{c.heading}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed mb-5">{c.body}</p>
                            <ul class="space-y-2 pt-5 border-t border-slate-200">
                                {c.features.map((f) => (
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <Icon
                                            name="heroicons:check"
                                            width="14"
                                            height="14"
                                            class:list={[
                                                'mt-1 shrink-0',
                                                c.color === 'primary' && 'text-primary',
                                                c.color === 'accent' && 'text-accent',
                                                c.color === 'secondary' && 'text-secondary-dark'
                                            ]}
                                        />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Equipment Types Section -->
    <section class="py-20 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Equipment Types We Handle</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    From small diagnostic devices and surgical instruments to larger imaging and laboratory systems, we handle a wide range of medical equipment for healthcare facilities and vendors.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
                {
                    equipmentTypes.map((e) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <Icon name={e.icon} width="28" height="28" class="text-primary mb-4" />
                            <h3 class="text-lg font-bold text-slate-900 mb-3">{e.heading}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed mb-5">{e.body}</p>
                            <ul class="grid grid-cols-2 gap-2 pt-5 border-t border-slate-200">
                                {e.features.map((f) => (
                                    <li class="flex items-start gap-2 text-sm text-slate-700">
                                        <Icon name="heroicons:check" width="14" height="14" class="text-primary mt-1 shrink-0" />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Safety & Compliance Section -->
    <section class="py-20 lg:py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="max-w-3xl mb-14 lg:mb-16">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight leading-[1.1] mb-5">Safety & Compliance Standards</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Our equipment transport service meets the highest industry standards for safety, compliance, and equipment protection.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
                {
                    safetyStandards.map((s) => (
                        <article class="bg-white rounded-2xl border border-slate-200 p-7">
                            <Icon
                                name={s.icon}
                                width="32"
                                height="32"
                                class:list={[
                                    'mb-5',
                                    s.color === 'primary' && 'text-primary',
                                    s.color === 'accent' && 'text-accent',
                                    s.color === 'secondary' && 'text-secondary-dark'
                                ]}
                            />
                            <h4 class="text-lg font-bold text-slate-900 mb-5">{s.heading}</h4>
                            <ul class="space-y-2.5">
                                {s.features.map((f) => (
                                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                                        <Icon name="mdi:check" width="16" height="16" class="text-secondary-dark mt-1 shrink-0" />
                                        <span class="leading-snug">{f}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section with Background -->
    <section class="relative overflow-hidden">
        <WaveClip side="top" amplitude={1} baseline={95} waves={1.25} phase={0} samples={36} class="absolute inset-0 py-24">
            <div class="absolute inset-0">
                <div
                    class="absolute inset-0 min-h-44"
                    style='background-image: url("/Images/personal box deliver.webp"); background-size: cover; background-repeat: no-repeat; background-position: center;'
                >
                </div>
            </div>
            <div class="absolute inset-0 bg-white/70"></div>
        </WaveClip>

        <div class="relative z-10 pt-36">
            <Cta {...ctaData} />
        </div>
    </section>

    <!-- Related Services -->
    <section class="py-16 lg:py-20 bg-white border-t border-slate-200">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
            <h2 class="text-xl font-bold text-slate-900 mb-8">Explore Our Other Services</h2>
            <div class="grid sm:grid-cols-2 gap-x-12 gap-y-6">
                <a href="/services/stat-delivery" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-accent transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-accent transition-colors mb-1">STAT Deliveries</h3>
                        <p class="text-sm text-slate-600">Rapid, secure transport of specimens, organs, and urgent medical equipment with real-time tracking.</p>
                    </div>
                    <Icon name="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-accent mt-1.5 transition-colors" />
                </a>
                <a href="/services/scheduled-routes" class="group flex items-start justify-between gap-4 py-4 border-b border-slate-200 hover:border-secondary-dark transition-colors">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-secondary-dark transition-colors mb-1">Scheduled Routes</h3>
                        <p class="text-sm text-slate-600">Recurring pickups and deliveries for clinics, labs, and research centers with route optimization.</p>
                    </div>
                    <Icon name="heroicons:arrow-right" width="20" height="20" class="text-slate-400 group-hover:text-secondary-dark mt-1.5 transition-colors" />
                </a>
            </div>
        </div>
    </section>
</Layout>
