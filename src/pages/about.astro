---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import Hero from '@components/Hero.astro';
import Cta from '@components/Cta.astro';
import { localBusiness, webSite, founder, breadcrumb } from '../lib/schema';
import WaveClip from '@components/WaveClip.astro';

const heroData = {
    title: 'About Trius LLC',
    subtitle: 'A Medical Courier Company Based in Tacoma, WA',
    body: 'We started Trius because the courier services hospitals were using kept dropping the ball. Missed windows, no tracking, drivers who didn\'t know a specimen from a package. We figured we could do better.'
};

const ctaData = {
    title: 'Want to talk about your routes?',
    body: 'Call or email. We\'ll put together a quote based on your actual volume, not a pricing calculator.',
    primaryAction: {
        label: 'Request Quote',
        url: '/contact'
    },
    secondaryAction: {
        label: 'View Our Services',
        url: '/services'
    }
};

const schema = {
    '@context': 'https://schema.org',
    '@graph': [localBusiness(), webSite(), founder(), breadcrumb([{ name: 'About', url: 'about' }])]
};
---

<Layout
    title="About Us - Trius LLC Medical Courier Services"
    description="Learn about Trius LLC's mission to provide reliable, professional medical courier services across WA, OR, ID, MT, and CA. Specialized expertise in medical logistics."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="About Us - Trius LLC Medical Courier Services"
            description="Learn about Trius LLC's mission to provide reliable, professional medical courier services across WA, OR, ID, MT, and CA. Specialized expertise in medical logistics."
            graph={schema}
        />
    </Fragment>

    <Hero
        backgroundImage="/Images/medical back stehescope.webp"
        overlayClass="bg-gradient-to-r from-primary/80 via-primary/60 to-secondary/70"
        minHeight="min-h-[70vh]"
        useWaveClip={true}
    >
        <div class="text-center max-w-4xl mx-auto">
            <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-white/85 mb-6">
                <span class="h-px w-8 bg-white/40"></span>
                About
                <span class="text-white/40">·</span>
                <span class="text-white/70">Tacoma, WA</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-5 tracking-tight leading-[1.05]">
                {heroData.title}
            </h1>
            <p class="text-lg md:text-xl text-white/85 mb-4 font-medium">
                {heroData.subtitle}
            </p>
            <p class="text-base md:text-lg text-white/75 leading-relaxed mb-8 max-w-2xl mx-auto">
                {heroData.body}
            </p>
            <a
                href="/contact"
                class="inline-flex items-center gap-2 px-7 py-3.5 bg-white text-primary font-semibold rounded-full hover:bg-white/95 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/40"
            >
                Get Started
                <iconify-icon icon="heroicons:arrow-right" width="16" height="16" />
            </a>
        </div>
    </Hero>
    <!-- Our Story -->
    <section class="py-20 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 lg:px-6 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Our Story</span>
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-6 leading-[1.15]">
                        Built by people who lived the logistics problem first.
                    </h2>
                    <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                        After years of working in orthopedic operations and logistics, we saw firsthand the gaps in traditional delivery
                        services. Missed time windows, lack of accountability, and limited understanding of how critical medical
                        deliveries truly are. Trius LLC was created to bridge that gap.
                    </p>
                    <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                        We specialize in the safe and efficient transportation of medical devices, surgical instruments, and time-sensitive
                        healthcare materials. Our drivers are trained in industry systems such as SetTrax and Casechek, understand hospital
                        workflows, and are experienced with everything from routine deliveries to urgent, same-day case support.
                    </p>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                        With TSA-verified drivers and access to secure facilities including airports and military bases, we provide a level
                        of reliability our clients can count on.
                    </p>
                    <figure class="mt-8 relative bg-primary/5 rounded-2xl p-6 lg:p-8">
                        <span aria-hidden="true" class="absolute -top-3 left-6 text-5xl leading-none font-brand font-black text-primary/40 select-none">&ldquo;</span>
                        <blockquote class="text-lg text-slate-700 italic leading-relaxed">
                            At Trius, we don't just move packages, we support patient care by ensuring the right equipment gets to the right place, at the right time.
                        </blockquote>
                    </figure>
                </div>
                <div class="bg-slate-50/70 ring-1 ring-slate-200 p-8 rounded-2xl">
                    <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Meet The Founder</span>
                    <div>
                        <div class="flex flex-col items-center text-center">
                            <img
                                src="/kevin_profile.webp"
                                alt="Kevin Hyatt, Founder of Trius LLC"
                                class="w-64 h-64 lg:w-72 lg:h-72 rounded-full object-cover mb-5 ring-1 ring-slate-200"
                                style="object-position: center 20%;"
                                loading="lazy"
                                decoding="async"
                                width="480"
                                height="640"
                            />
                            <h3 class="font-bold text-slate-900 text-lg">Kevin Hyatt</h3>
                            <p class="text-sm text-slate-500 font-medium tracking-wide uppercase mt-1">Founder</p>
                            <p class="text-sm text-slate-600 mt-3 leading-relaxed max-w-xs">
                                With years of experience in orthopedic operations and logistics, Kevin founded Trius LLC to deliver the
                                reliability and accountability that medical professionals deserve.
                            </p>
                        </div>
                    </div>

                    <!-- Fleet Gallery -->
                    <div class="mt-8 pt-6 border-t border-slate-200">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <div class="text-xs font-bold uppercase tracking-[0.16em] text-primary">In the Field</div>
                                <div class="text-sm text-slate-500 mt-1">A snapshot of Trius vehicles serving healthcare facilities</div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-3">
                            <div class="relative rounded-2xl overflow-hidden aspect-[16/9] shadow-md">
                                <img
                                    src="/Images/trius-van-hospital.webp"
                                    alt="Trius delivery van at hospital facility"
                                    class="w-full h-full object-cover"
                                    style="object-position: center center;"
                                    loading="lazy"
                                    decoding="async"
                                    width="432"
                                    height="538"
                                />
                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/70 to-transparent p-4">
                                    <p class="text-sm font-semibold text-white">Hospital and facility service</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div class="relative rounded-2xl overflow-hidden aspect-[16/10] shadow-md">
                                    <img
                                        src="/Images/trius-van-office.webp"
                                        alt="Trius delivery van at office building"
                                        class="w-full h-full object-cover"
                                        style="object-position: center center;"
                                        loading="lazy"
                                        decoding="async"
                                        width="432"
                                        height="538"
                                    />
                                </div>
                                <div class="relative rounded-2xl overflow-hidden aspect-[16/10] shadow-md">
                                    <img
                                        src="/Images/trius-van-building.webp"
                                        alt="Trius delivery van at medical facility"
                                        class="w-full h-full object-cover"
                                        style="object-position: center center;"
                                        loading="lazy"
                                        decoding="async"
                                        width="432"
                                        height="538"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How We Work -->
    <section class="py-20 bg-gradient-to-br from-slate-50 via-primary/5 to-secondary/5">
        <div class="max-w-5xl mx-auto px-4 lg:px-6">
            <div class="mb-14 max-w-2xl">
                <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">How We Work</span>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-[1.1]">
                    Three things we care about. Everything else follows.
                </h2>
            </div>

            <ol class="divide-y divide-slate-200/80">
                {[
                    {
                        title: 'Show Up On Time',
                        body: "If the pickup window is 2:15, we're there at 2:10. Surgical schedules don't flex because a driver hit traffic. We plan for that.",
                        icon: 'heroicons:clock'
                    },
                    {
                        title: 'Document Everything',
                        body: "Chain of custody, photo verification, temperature logs when needed. If something goes sideways, there's a paper trail. That's the point.",
                        icon: 'heroicons:document-check'
                    },
                    {
                        title: 'Pick Up the Phone',
                        body: "You call, a real person answers. Not a menu, not a chatbot, not a callback in 24 hours. We answer because that's what matters when a case is on the line.",
                        icon: 'heroicons:phone'
                    }
                ].map((item, idx) => (
                    <li class="py-8 lg:py-10 first:pt-0 last:pb-0">
                        <div class="grid grid-cols-[auto_1fr] lg:grid-cols-[7rem_1fr] gap-6 lg:gap-12 items-start">
                            <div class="flex items-center gap-3 lg:flex-col lg:items-start lg:gap-4">
                                <span class="font-mono text-2xl lg:text-3xl font-bold text-primary tabular-nums leading-none">
                                    {String(idx + 1).padStart(2, '0')}
                                </span>
                                <iconify-icon icon={item.icon} width="22" height="22" class="text-slate-400 hidden lg:block" />
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-xl lg:text-2xl font-bold text-slate-900 mb-3 tracking-tight">{item.title}</h3>
                                <p class="text-base lg:text-lg text-slate-600 leading-relaxed max-w-2xl">{item.body}</p>
                            </div>
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- Why Trius -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 lg:px-6">
            <div class="mb-16">
                <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Why Trius</span>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-[1.1] max-w-2xl">
                    We haul medical cargo.<br class="hidden sm:block" /> That's it. That's the whole company.
                </h2>
            </div>

            <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
                <div class="flex gap-5">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                        <iconify-icon icon="heroicons:beaker" width="24" height="24" class="text-primary"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Healthcare-only fleet</h3>
                        <p class="text-slate-600 leading-relaxed">
                            No pizza. No parcels. Our vans carry specimens, implant trays, and surgical instruments, and nothing else rides alongside them.
                        </p>
                    </div>
                </div>

                <div class="flex gap-5">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                        <iconify-icon icon="heroicons:map" width="24" height="24" class="text-primary"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Five states, one team</h3>
                        <p class="text-slate-600 leading-relaxed">
                            WA, OR, ID, MT, Northern CA. We know which docks lock at 6 PM, which labs need a code, and where the freight elevator actually is.
                        </p>
                    </div>
                </div>

                <div class="flex gap-5">
                    <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center flex-shrink-0 mt-1">
                        <iconify-icon icon="heroicons:phone-arrow-up-right" width="24" height="24" class="text-accent"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">We answer at 3 AM</h3>
                        <p class="text-slate-600 leading-relaxed">
                            Saturday implant case. Holiday organ retrieval. Middle-of-the-night STAT. Someone picks up and a driver dispatches, every time.
                        </p>
                    </div>
                </div>

                <div class="flex gap-5">
                    <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center flex-shrink-0 mt-1">
                        <iconify-icon icon="heroicons:receipt-percent" width="24" height="24" class="text-secondary-dark"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">The quote is the price</h3>
                        <p class="text-slate-600 leading-relaxed">
                            No surge fees, no after-hours markups, no line items that weren't in the original conversation. Tuesday rate = Friday midnight rate.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Credentials -->
    <section class="py-20 bg-slate-50 relative overflow-hidden">
        <div class="max-w-5xl mx-auto px-4 lg:px-6 relative z-10">
            <div class="mb-14 max-w-2xl">
                <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Credentials</span>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-[1.1] max-w-3xl">
                    The paperwork that gets us past the badge reader.
                </h2>
                <p class="mt-4 text-lg text-slate-600 max-w-2xl leading-relaxed">
                    Restricted docks, sterile processing, airside facilities. We carry the clearances so your deliveries don't stall at the front desk.
                </p>
            </div>

            <dl class="divide-y divide-slate-200/80 border-y border-slate-200/80">
                {[
                    {
                        title: 'TSA Verified',
                        body: 'Cleared for airports, military installations, and secured healthcare wings where standard couriers get turned away at the gate.',
                        icon: 'heroicons:shield-check'
                    },
                    {
                        title: 'SetTrax & Casechek certified',
                        body: 'We log into the same case management systems your SPD team uses: scan, verify, confirm. No training lag on day one.',
                        icon: 'heroicons:academic-cap'
                    },
                    {
                        title: 'DOT compliant',
                        body: 'Interstate-rated vehicles, current inspections, compliant driver records. The boring stuff that matters when cargo crosses state lines.',
                        icon: 'heroicons:document-check'
                    },
                    {
                        title: 'Fully insured, every run',
                        body: "Commercial cargo coverage plus liability on every pickup. A $40K implant tray doesn't ride without a policy behind it.",
                        icon: 'heroicons:shield-exclamation'
                    }
                ].map((item) => (
                    <div class="grid grid-cols-[auto_1fr] md:grid-cols-[14rem_1fr] gap-x-6 md:gap-x-10 gap-y-2 py-7 lg:py-8">
                        <dt class="flex items-center gap-3">
                            <iconify-icon
                                icon={item.icon}
                                width="20"
                                height="20"
                                class="text-primary shrink-0"
                            />
                            <span class="text-base font-bold text-slate-900 tracking-tight">{item.title}</span>
                        </dt>
                        <dd class="text-base text-slate-600 leading-relaxed col-start-1 md:col-start-2 max-w-2xl">
                            {item.body}
                        </dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>
    <!-- CTA Section with Background -->
    <section class="relative overflow-hidden">
        <WaveClip
            side="top"
            amplitude={1}
            baseline={95}
            waves={1.25}
            phase={0}
            samples={36}
            topBaseline={10}
            topAmplitude={1}
            topPhase={0}
            class="absolute inset-0 py-24"
        >
            <div class="absolute inset-0">
                <div
                    class="absolute inset-0 min-h-44"
                    style='background-image: url("/Images/Courier handoff.webp"); background-size: cover; background-repeat: no-repeat; background-position: center;'
                >
                </div>
            </div>
            <div class="absolute inset-0 bg-white/60"></div>
        </WaveClip>
        <div class="relative z-10 pt-24">
            <Cta {...ctaData} />
        </div>
    </section>
</Layout>
