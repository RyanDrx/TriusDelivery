---
import Layout from '@layouts/Layout.astro';
import SEO from '@components/SEO.astro';
import HomeHero from '@components/HomeHero.astro';
import TrustSection from '@components/TrustSection.astro';
import Cta from '@components/Cta.astro';
import FAQSection from '@components/FAQSection.astro';
import { graphHome } from '../lib/schema.ts';
import WaveClip from '@components/WaveClip.astro';
import { homeFaqs } from '../data/seoContent';

// Temporary static data for home page (will be replaced with Sanity later)
const heroData = {
    _type: 'heroSection',
    heading: 'Reliable Medical Courier Services You Can Trust',
    body: 'Medical courier services for hospitals, labs, clinics, and surgery centers. STAT transport, scheduled routes, and equipment logistics across five states.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Request Quote',
            url: '/contact',
            theme: 'primary'
        },
        {
            _key: '2',
            _type: 'actionLink',
            label: 'Our Services',
            url: '/services'
        }
    ]
};

const ctaData = {
    _type: 'ctaSection',
    heading: 'Get a Secure Medical Courier Partner Today',
    body: 'Join 150+ healthcare organizations that trust Trius. Get a free quote today.',
    cta: [
        {
            _key: '1',
            _type: 'actionButton',
            label: 'Get Your Free Quote',
            url: '/contact',
            theme: 'primary'
        },
        {
            _key: '2',
            _type: 'actionLink',
            label: 'Learn About Our Process',
            url: '/services',
            theme: 'secondary'
        }
    ]
};

const facilitiesServed = [
    'Hospitals and health systems',
    'Laboratories and diagnostic centers',
    'Clinics and physician offices',
    'Ambulatory surgery centers',
    'Pharmacies and infusion teams',
    'Research and life sciences operations',
    'Medical device representatives',
    'Imaging and specialty care groups'
];

const deliveryTypes = [
    'Medical specimens and lab samples',
    'Bloodwork, pathology materials, and test kits',
    'Pharmaceuticals and temperature-sensitive packages',
    'Surgical instruments and implant support',
    'Diagnostic devices and sensitive equipment',
    'Interoffice transfers between healthcare locations',
    'Emergency STAT pickups with chain of custody',
    'Recurring route-based medical logistics'
];

const schema = graphHome();
---

<Layout
    title="Medical Courier Services | Trius LLC"
    description="Medical courier services for hospitals, labs, clinics, surgery centers, pharmacies, and research teams. Trius handles STAT specimen transport, scheduled routes, and medical equipment delivery across Washington, Oregon, Idaho, Montana, and Northern California."
    image={{ src: '/og-image.png' }}
>
    <Fragment slot="head">
        <SEO
            title="Medical Courier Services | Trius LLC"
            description="Medical courier services for hospitals, labs, clinics, surgery centers, pharmacies, and research teams. Trius handles STAT specimen transport, scheduled routes, and medical equipment delivery across Washington, Oregon, Idaho, Montana, and Northern California."
            graph={schema}
        />
    </Fragment>

    <HomeHero {...heroData} />

    <!-- Services Section -->
    <section class="relative bg-slate-50 py-16 md:py-24 lg:py-28 overflow-hidden">
        <!-- Subtle brand-tinted radial accents (not the heavy wave wash) -->
        <div
            aria-hidden="true"
            class="absolute -top-32 right-0 w-[40rem] h-[20rem] bg-[radial-gradient(ellipse_at_top_right,rgba(14,112,164,0.10),transparent_65%)] pointer-events-none"
        >
        </div>
        <div
            aria-hidden="true"
            class="absolute -bottom-32 left-0 w-[40rem] h-[20rem] bg-[radial-gradient(ellipse_at_bottom_left,rgba(95,168,67,0.08),transparent_65%)] pointer-events-none"
        >
        </div>

        <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
            <!-- Section header -->
            <header class="mb-12 lg:mb-16 max-w-2xl">
                <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-primary mb-5">
                    <span class="h-px w-8 bg-primary/40"></span>
                    Services
                </div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-[1.1]">
                    Fast, secure, and compliant medical transport.
                </h2>
                <p class="mt-5 text-lg text-slate-600 leading-relaxed">
                    STAT specimen deliveries, scheduled lab routes, and specialized equipment transport for
                    healthcare teams across five states.
                </p>
            </header>

            <!-- Bento grid: STAT featured tall, Scheduled + Equipment stacked right -->
            <div class="grid lg:grid-cols-12 lg:auto-rows-fr gap-5 lg:gap-6">
                <!-- STAT (priority, featured large) -->
                <article class="lg:col-span-7 lg:row-span-2 group relative bg-white rounded-3xl border border-accent/25 ring-1 ring-accent/10 p-8 lg:p-10 flex flex-col overflow-hidden shadow-[0_20px_60px_-32px_rgba(197,48,48,0.25)] hover:shadow-[0_24px_70px_-32px_rgba(197,48,48,0.32)] transition-shadow duration-300">
                    <!-- Corner heat accent -->
                    <div
                        aria-hidden="true"
                        class="absolute -top-24 -right-24 w-72 h-72 bg-[radial-gradient(circle,rgba(197,48,48,0.10),transparent_70%)] pointer-events-none"
                    >
                    </div>

                    <div class="flex items-center gap-3 mb-7">
                        <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-accent shadow-md shadow-accent/20">
                            <iconify-icon icon="heroicons:bolt" width="28" height="28" class="text-white" />
                        </span>
                        <span class="flex items-center gap-2 font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-accent">
                            <span class="relative flex h-2 w-2" aria-hidden="true">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-70"></span>
                                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
                            </span>
                            Priority · STAT
                        </span>
                    </div>

                    <h3 class="text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 leading-[1.1]">
                        STAT Deliveries
                    </h3>
                    <p class="mt-2 text-xs font-bold uppercase tracking-[0.18em] text-accent">
                        When every minute counts
                    </p>

                    <p class="mt-6 text-base lg:text-lg text-slate-600 leading-relaxed max-w-md">
                        Urgent transport for specimens, organs, and critical medical equipment, backed by
                        full chain-of-custody verification and real-time tracking.
                    </p>

                    <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-x-6 gap-y-3 max-w-lg">
                        {[
                            { icon: 'heroicons:shield-check', text: 'Verified chain of custody' },
                            { icon: 'heroicons:map-pin', text: 'Live GPS tracking' },
                            { icon: 'heroicons:star', text: 'Priority handling' },
                            { icon: 'heroicons:clock', text: '24/7 dispatch' }
                        ].map((f) => (
                            <li class="flex items-center gap-2.5 text-sm text-slate-700">
                                <iconify-icon icon={f.icon} width="16" height="16" class="text-accent shrink-0" />
                                <span>{f.text}</span>
                            </li>
                        ))}
                    </ul>

                    <a
                        href="/services/stat-delivery"
                        class="mt-auto pt-10 inline-flex items-center gap-2 text-accent font-bold text-base group/cta self-start"
                    >
                        Request STAT Delivery
                        <iconify-icon
                            icon="heroicons:arrow-right"
                            width="18"
                            height="18"
                            class="transition-transform duration-200 group-hover/cta:translate-x-0.5"
                        />
                    </a>
                </article>

                <!-- Scheduled Routes -->
                <article class="lg:col-span-5 group relative bg-white rounded-3xl border border-slate-200 p-7 lg:p-8 flex flex-col hover:border-primary/30 transition-colors duration-200">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 ring-1 ring-primary/15">
                            <iconify-icon icon="heroicons:calendar-days" width="22" height="22" class="text-primary" />
                        </span>
                        <span class="font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-primary">
                            Recurring
                        </span>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight text-slate-900">Scheduled Routes</h3>
                    <p class="mt-1.5 text-xs font-bold uppercase tracking-[0.18em] text-primary/80">
                        Reliable, recurring transport
                    </p>
                    <p class="mt-5 text-sm lg:text-base text-slate-600 leading-relaxed">
                        Trusted daily and weekly pickups for clinics, labs, and research centers with ongoing
                        logistical needs.
                    </p>
                    <a
                        href="/services/scheduled-routes"
                        class="mt-auto pt-6 inline-flex items-center gap-2 text-primary font-bold text-sm group/cta self-start"
                    >
                        Schedule a route
                        <iconify-icon
                            icon="heroicons:arrow-right"
                            width="16"
                            height="16"
                            class="transition-transform duration-200 group-hover/cta:translate-x-0.5"
                        />
                    </a>
                </article>

                <!-- Specialized Equipment -->
                <article class="lg:col-span-5 group relative bg-white rounded-3xl border border-slate-200 p-7 lg:p-8 flex flex-col hover:border-secondary/30 transition-colors duration-200">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-secondary/10 ring-1 ring-secondary/15">
                            <iconify-icon icon="heroicons:truck" width="22" height="22" class="text-secondary-dark" />
                        </span>
                        <span class="font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-secondary-dark">
                            Specialized
                        </span>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight text-slate-900">Equipment Transport</h3>
                    <p class="mt-1.5 text-xs font-bold uppercase tracking-[0.18em] text-secondary-dark/80">
                        Expert handling, sensitive devices
                    </p>
                    <p class="mt-5 text-sm lg:text-base text-slate-600 leading-relaxed">
                        Secure movement of regulated, fragile, or temperature-sensitive medical equipment by
                        trained professionals.
                    </p>
                    <a
                        href="/services/specialized-equipment"
                        class="mt-auto pt-6 inline-flex items-center gap-2 text-secondary-dark font-bold text-sm group/cta self-start"
                    >
                        Book transport
                        <iconify-icon
                            icon="heroicons:arrow-right"
                            width="16"
                            height="16"
                            class="transition-transform duration-200 group-hover/cta:translate-x-0.5"
                        />
                    </a>
                </article>
            </div>
        </div>
    </section>

    <TrustSection />

    <section class="py-16 md:py-24 lg:py-28 bg-white">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
            <!-- Section header -->
            <header class="mb-12 lg:mb-16 max-w-2xl">
                <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.22em] text-primary mb-5">
                    <span class="h-px w-8 bg-primary/40"></span>
                    Coverage
                </div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-[1.1]">
                    Built for healthcare logistics.
                </h2>
                <p class="mt-5 text-lg text-slate-600 leading-relaxed">
                    Urgent medical courier support, scheduled route coverage, and specialized handling for sensitive
                    deliveries across Washington, Oregon, Idaho, Montana, and Northern California.
                </p>
            </header>

            <!-- Who we serve / What we move — divided lists, no nested cards -->
            <div class="grid lg:grid-cols-2 gap-x-12 gap-y-12">
                <!-- Facilities -->
                <div>
                    <div class="flex items-center gap-3 mb-7">
                        <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-primary/10 ring-1 ring-primary/15">
                            <iconify-icon icon="heroicons:user-group" width="22" height="22" class="text-primary" />
                        </span>
                        <div>
                            <div class="font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-primary">
                                Who we serve
                            </div>
                            <h3 class="text-xl lg:text-2xl font-bold tracking-tight text-slate-900 mt-1">
                                Healthcare organizations
                            </h3>
                        </div>
                    </div>
                    <ul class="divide-y divide-slate-200/80 border-y border-slate-200/80">
                        {
                            facilitiesServed.map((item) => (
                                <li class="flex items-center gap-3 py-3.5">
                                    <iconify-icon
                                        icon="heroicons:check"
                                        width="18"
                                        height="18"
                                        class="text-primary shrink-0"
                                    />
                                    <span class="text-sm md:text-base text-slate-700">{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Cargo -->
                <div>
                    <div class="flex items-center gap-3 mb-7">
                        <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-secondary/10 ring-1 ring-secondary/15">
                            <iconify-icon icon="heroicons:archive-box" width="22" height="22" class="text-secondary-dark" />
                        </span>
                        <div>
                            <div class="font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-secondary-dark">
                                What we move
                            </div>
                            <h3 class="text-xl lg:text-2xl font-bold tracking-tight text-slate-900 mt-1">
                                Healthcare cargo
                            </h3>
                        </div>
                    </div>
                    <ul class="divide-y divide-slate-200/80 border-y border-slate-200/80">
                        {
                            deliveryTypes.map((item) => (
                                <li class="flex items-center gap-3 py-3.5">
                                    <iconify-icon
                                        icon="heroicons:check"
                                        width="18"
                                        height="18"
                                        class="text-secondary-dark shrink-0"
                                    />
                                    <span class="text-sm md:text-base text-slate-700">{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <!-- Related service links — kept for SEO, restyled quieter -->
            <div class="mt-14 pt-8 border-t border-slate-200/70">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-3 sm:gap-6">
                    <div class="font-mono text-[0.6rem] font-bold tracking-[0.26em] uppercase text-slate-500 shrink-0">
                        Related
                    </div>
                    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
                        <a
                            href="/services/stat-delivery"
                            class="inline-flex items-center gap-1.5 text-accent font-semibold hover:text-accent-dark transition-colors group/link"
                        >
                            STAT medical courier
                            <iconify-icon
                                icon="heroicons:arrow-up-right"
                                width="12"
                                height="12"
                                class="opacity-60 group-hover/link:opacity-100 transition-opacity"
                            />
                        </a>
                        <span class="text-slate-300">/</span>
                        <a
                            href="/services/scheduled-routes"
                            class="inline-flex items-center gap-1.5 text-primary font-semibold hover:text-primary-dark transition-colors group/link"
                        >
                            Scheduled medical routes
                            <iconify-icon
                                icon="heroicons:arrow-up-right"
                                width="12"
                                height="12"
                                class="opacity-60 group-hover/link:opacity-100 transition-opacity"
                            />
                        </a>
                        <span class="text-slate-300">/</span>
                        <a
                            href="/services/specialized-equipment"
                            class="inline-flex items-center gap-1.5 text-secondary-dark font-semibold hover:text-secondary-dark/80 transition-colors group/link"
                        >
                            Medical equipment transport
                            <iconify-icon
                                icon="heroicons:arrow-up-right"
                                width="12"
                                height="12"
                                class="opacity-60 group-hover/link:opacity-100 transition-opacity"
                            />
                        </a>
                        <span class="text-slate-300">/</span>
                        <a
                            href="/coverage"
                            class="inline-flex items-center gap-1.5 text-slate-700 font-semibold hover:text-slate-900 transition-colors group/link"
                        >
                            Pacific Northwest coverage
                            <iconify-icon
                                icon="heroicons:arrow-up-right"
                                width="12"
                                height="12"
                                class="opacity-60 group-hover/link:opacity-100 transition-opacity"
                            />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <FAQSection
        heading="Answers to Common Medical Courier Questions"
        intro="Clear answers about service area, delivery types, STAT availability, and recurring routes for healthcare teams evaluating Trius."
        items={homeFaqs}
    />

    <!-- CTA Section with Background -->
    <section class="relative overflow-hidden">
        <!-- Desktop WaveClip Background -->
        <WaveClip
            side="top"
            amplitude={1}
            baseline={95}
            waves={1.25}
            phase={0}
            samples={36}
            topBaseline={10}
            topAmplitude={1}
            topPhase={0}
            class="absolute inset-0 py-24 hidden lg:block"
        >
            <div class='absolute inset-0'>
                <div
                    class="absolute inset-0 min-h-44"
                    style='background-image: url("/Images/personal box deliver.webp"); background-size: cover; background-repeat: no-repeat; background-position: center;'
                >
                </div>
            </div>
            <div class='absolute inset-0 bg-white/60'></div>
        </WaveClip>

        <!-- Mobile Simple Background -->
        <div class="absolute inset-0 lg:hidden bg-gradient-to-br from-slate-50 via-primary/4 to-secondary/4"></div>
        <div class="relative z-10 pt-24">
            <Cta {...ctaData} />
        </div>
    </section>
</Layout>
