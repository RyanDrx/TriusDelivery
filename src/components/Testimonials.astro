---
import { safeMarkdown } from '@utils/markdown';
import { type TestimonialsSection } from 'types';
import Testimonial from '@components/Testimonial.astro';
import Section from '@components/Section.astro';

interface Props extends TestimonialsSection {
    'data-sb-field-path'?: string;
}

const { heading, body, items, columns, ...rest } = Astro.props;
const isStacked = columns === 'one' || !items || items.length <= 1;
---

<Section {...rest} class="bg-white">
    <div class="max-w-6xl mx-auto px-2">
        {
            (heading || body) && (
                <header class="mb-12 lg:mb-16 max-w-2xl">
                    <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-primary mb-5">
                        <span class="h-px w-8 bg-primary/40" />
                        From the field
                    </div>
                    {heading && (
                        <h2
                            class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.1] tracking-tight text-balance"
                            data-sb-field-path=".heading"
                        >
                            {heading}
                        </h2>
                    )}
                    {body && (
                        <div
                            class="mt-5 text-lg text-slate-600 leading-relaxed markdown"
                            data-sb-field-path=".body"
                            set:html={safeMarkdown(body)}
                        />
                    )}
                </header>
            )
        }

        {
            items && items.length > 0 && (
                <ol
                    class:list={[
                        isStacked
                            ? 'divide-y divide-slate-200 max-w-3xl mx-auto'
                            : 'grid gap-x-12 lg:grid-cols-2 lg:gap-x-16',
                        !isStacked && 'divide-y divide-slate-200 lg:divide-y-0'
                    ]}
                    data-sb-field-path=".items"
                >
                    {items.map((testimonial, idx) => (
                        <li
                            class:list={[
                                'py-10 lg:py-12',
                                isStacked && 'first:pt-0 last:pb-0',
                                !isStacked && 'lg:first:pt-0 lg:[&:nth-child(2)]:lg:pt-0 last:pb-0'
                            ]}
                        >
                            <Testimonial
                                {...testimonial}
                                index={idx + 1}
                                density={isStacked ? 'comfortable' : 'condensed'}
                                data-sb-field-path={`.${idx}`}
                            />
                        </li>
                    ))}
                </ol>
            )
        }
    </div>
</Section>
