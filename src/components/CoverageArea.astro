---
export interface Props {
    title?: string;
    description?: string;
    'data-sb-field-path'?: string;
}

const {
    title = 'Our Service Coverage Area',
    description = 'Reliable medical courier services across the Pacific Northwest and California',
    'data-sb-field-path': fieldPath
} = Astro.props;

const states = [
    { name: 'Washington', abbreviation: 'WA', svg: '/states/WA.svg' },
    { name: 'Oregon', abbreviation: 'OR', svg: '/states/OR.svg' },
    { name: 'Idaho', abbreviation: 'ID', svg: '/states/ID.svg' },
    { name: 'Montana', abbreviation: 'MT', svg: '/states/MT.svg' },
    { name: 'California', abbreviation: 'CA', svg: '/states/CA.svg' }
] as const;
---

<section
    class="mt-12 animate-fade-in-up"
    style="animation-delay: 1.4s;"
    aria-labelledby="coverage-area-title"
    data-sb-field-path={fieldPath}
>
    <header class="text-center max-w-2xl mx-auto mb-8 sm:mb-10 px-4">
        <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-primary mb-4">
            <span class="h-px w-8 bg-primary/40"></span>
            5-State Network
        </div>
        <h3
            id="coverage-area-title"
            class="text-2xl lg:text-3xl font-bold text-slate-900 tracking-tight mb-3"
        >
            {title}
        </h3>
        <p class="text-base text-slate-600 leading-relaxed">{description}</p>
    </header>

    <ul
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 max-w-4xl mx-auto px-4"
        role="list"
    >
        {
            states.map((state) => (
                <li class="group">
                    <div class="flex flex-col items-center gap-3 rounded-2xl border border-slate-200/70 bg-white/85 backdrop-blur-sm px-3 py-5 sm:py-6 h-full transition-colors duration-200 hover:border-primary/40 hover:bg-white">
                        <div class="grid place-items-center w-14 h-14 sm:w-16 sm:h-16 rounded-xl bg-primary/[0.06] ring-1 ring-primary/10 transition-colors duration-200 group-hover:bg-primary/10 group-hover:ring-primary/25">
                            <img
                                src={state.svg}
                                alt=""
                                width="40"
                                height="40"
                                class="w-9 h-9 sm:w-10 sm:h-10 state-shape"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <div class="text-center">
                            <div class="font-bold text-slate-900 text-sm sm:text-base leading-tight">
                                {state.name}
                            </div>
                            <div class="text-[0.7rem] font-mono uppercase tracking-[0.18em] text-slate-400 mt-1">
                                {state.abbreviation}
                            </div>
                        </div>
                    </div>
                </li>
            ))
        }
    </ul>
</section>

<style>
    /* Tint state silhouettes to the primary brand color without relying on
       per-state inline filters. Approximates oklch(45% 0.10 245) for #0e70a4. */
    .state-shape {
        filter: brightness(0) saturate(100%) invert(34%) sepia(58%) saturate(1976%) hue-rotate(178deg)
            brightness(92%) contrast(96%);
        transition: filter 0.2s ease;
    }

    .group:hover .state-shape {
        filter: brightness(0) saturate(100%) invert(28%) sepia(60%) saturate(2200%) hue-rotate(178deg)
            brightness(86%) contrast(100%);
    }

    @media (prefers-reduced-motion: reduce) {
        .state-shape {
            transition: none;
        }
    }
</style>
