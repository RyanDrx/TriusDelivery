---
import { safeMarkdown } from '@utils/markdown';
import { type Testimonial } from 'types';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends Testimonial {
    class?: string;
    index?: number;
    density?: 'comfortable' | 'condensed';
    'data-sb-field-path'?: string;
}

const { quote, author, class: className, index, density = 'comfortable', 'data-sb-field-path': fieldPath } = Astro.props;

const monogram = author?.name?.trim().charAt(0).toUpperCase() ?? '';
const indexLabel = typeof index === 'number' ? String(index).padStart(2, '0') : null;
const isCondensed = density === 'condensed';
---

<figure class:list={['relative', className]} data-sb-field-path={fieldPath}>
    {
        indexLabel && (
            <div class="flex items-center gap-4 mb-6" aria-hidden="true">
                <span class="font-mono text-[0.7rem] font-bold tracking-[0.25em] text-primary uppercase">
                    No. {indexLabel}
                </span>
                <span class="h-px flex-1 bg-slate-200" />
            </div>
        )
    }

    {
        quote && (
            <blockquote
                class:list={[
                    'text-slate-900 font-medium tracking-[-0.01em]',
                    isCondensed
                        ? 'text-lg lg:text-xl leading-[1.55]'
                        : 'text-xl md:text-2xl lg:text-[1.6rem] leading-[1.45]'
                ]}
                data-sb-field-path=".quote"
                set:html={safeMarkdown(quote)}
            />
        )
    }

    {
        author && (
            <figcaption
                class:list={[
                    'flex items-start gap-4 mt-8',
                    isCondensed && 'mt-6'
                ]}
                data-sb-field-path=".author"
            >
                {author.image?.src ? (
                    <div
                        class:list={[
                            'overflow-hidden rounded-full ring-1 ring-slate-200 shrink-0',
                            isCondensed ? 'w-10 h-10' : 'w-12 h-12'
                        ]}
                    >
                        <ResponsiveImage
                            _id={author.image._id}
                            src={author.image.src}
                            width={isCondensed ? 40 : 48}
                            height={isCondensed ? 40 : 48}
                            alt={author.image.alt}
                            class="object-cover w-full h-full"
                        />
                    </div>
                ) : (
                    monogram && (
                        <div
                            class:list={[
                                'flex items-center justify-center rounded-full bg-primary/10 text-primary font-black font-brand shrink-0',
                                isCondensed ? 'w-10 h-10 text-base' : 'w-12 h-12 text-lg'
                            ]}
                            aria-hidden="true"
                        >
                            {monogram}
                        </div>
                    )
                )}

                <div class="min-w-0 flex-1 leading-snug">
                    <div
                        class:list={[
                            'font-bold text-slate-900 break-words',
                            isCondensed ? 'text-sm' : 'text-base'
                        ]}
                        data-sb-field-path=".name"
                    >
                        {author.name}
                    </div>
                    {author.title && (
                        <div
                            class:list={[
                                'text-slate-600 break-words mt-0.5',
                                isCondensed ? 'text-xs' : 'text-sm'
                            ]}
                            data-sb-field-path=".title"
                        >
                            {author.title}
                        </div>
                    )}
                    {author.company && (
                        <div
                            class:list={[
                                'text-slate-500 break-words mt-0.5',
                                isCondensed ? 'text-xs' : 'text-sm'
                            ]}
                            data-sb-field-path=".company"
                        >
                            {author.company?.logo?.src ? (
                                <ResponsiveImage
                                    _id={author.company.logo._id}
                                    src={author.company.logo.src}
                                    width={author.company.logo.dimensions?.width}
                                    height={author.company.logo.dimensions?.height}
                                    alt={author.company.logo.alt}
                                    class="max-h-5 w-auto mt-1"
                                />
                            ) : (
                                <span data-sb-field-path=".name">{author.company.name}</span>
                            )}
                        </div>
                    )}
                </div>
            </figcaption>
        )
    }
</figure>
