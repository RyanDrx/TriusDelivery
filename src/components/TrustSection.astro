---
import Section from '@components/Section.astro';
import { Icon } from 'astro-icon/components';

interface Props {
    'data-sb-field-path'?: string;
}

const { 'data-sb-field-path': fieldPath } = Astro.props;

const testimonials = [
    {
        quote: 'Trius LLC has been a huge asset to my work as a sales rep. Knowing that my instrument trays and implants are picked up and delivered on time means I can focus on my surgeons and their cases instead of worrying about logistics. Having real-time tracking has been a game changer.',
        role: 'Sales Representative',
        company: 'Medical Device Sales',
        monogram: 'R'
    },
    {
        quote: "Working with Trius LLC has been a game-changer for our practice. Their team is always on time, professional, and communicates clearly every step of the way. The real-time tracking and photo verification are features we didn't know we needed, but now can't imagine being without.",
        role: 'Operations Manager',
        company: 'ZimmerBiomet Orthopedics',
        monogram: 'Z'
    },
    {
        quote: 'Trius LLC has made a tremendous difference in how we manage our surgical instrument trays. Their drivers understand the importance of sterile processing. Everything is scanned, documented, and tracked with precision. Thanks to Trius LLC, our SPD can focus on quality and turnaround instead of chasing down deliveries.',
        role: 'SPD Staff',
        company: 'St. Claire Hospital',
        monogram: 'S'
    }
];

const stats = [
    { value: '99.9%', label: 'On-time delivery', icon: 'lucide:clock' },
    { value: '24/7', label: 'Live response', icon: 'lucide:phone' },
    { value: '100%', label: 'Chain of custody', icon: 'lucide:shield-check' }
];
---

<Section class="bg-white py-16 lg:py-24" data-sb-field-path={fieldPath}>
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
        <!-- Section Header -->
        <header class="mb-12 lg:mb-16 max-w-2xl">
            <div class="inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-primary mb-5">
                <span class="h-px w-8 bg-primary/40"></span>
                From the field
            </div>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.1] tracking-tight text-balance">
                Trusted by the people who actually move healthcare.
            </h2>
        </header>

        <!-- Editorial Testimonials -->
        <ol class="divide-y divide-slate-200 max-w-3xl mx-auto">
            {
                testimonials.map((t, idx) => (
                    <li class="py-10 lg:py-12 first:pt-0 last:pb-0">
                        <figure class="relative">
                            <div class="flex items-center gap-4 mb-6" aria-hidden="true">
                                <span class="font-mono text-[0.7rem] font-bold tracking-[0.25em] text-primary uppercase">
                                    No. {String(idx + 1).padStart(2, '0')}
                                </span>
                                <span class="h-px flex-1 bg-slate-200" />
                            </div>

                            <blockquote class="text-xl md:text-2xl lg:text-[1.6rem] text-slate-900 font-medium tracking-[-0.01em] leading-[1.45]">
                                {t.quote}
                            </blockquote>

                            <figcaption class="flex items-start gap-4 mt-8">
                                <div
                                    class="flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary font-black font-brand text-lg shrink-0"
                                    aria-hidden="true"
                                >
                                    {t.monogram}
                                </div>
                                <div class="min-w-0 flex-1 leading-snug">
                                    <div class="font-bold text-slate-900 text-base break-words">{t.role}</div>
                                    <div class="text-slate-500 text-sm break-words mt-0.5">{t.company}</div>
                                </div>
                            </figcaption>
                        </figure>
                    </li>
                ))
            }
        </ol>

        <!-- Stats -->
        <div class="mt-16 lg:mt-20 pt-10 lg:pt-12 border-t border-slate-200">
            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-y-8 sm:gap-y-0 sm:gap-x-8">
                {
                    stats.map((stat) => (
                        <div class="flex items-start gap-4 sm:flex-col sm:items-start sm:gap-3">
                            <Icon
                                name={stat.icon}
                                width="22"
                                height="22"
                                class="text-primary shrink-0 mt-1 sm:mt-0"
                            />
                            <div>
                                <dt class="sr-only">{stat.label}</dt>
                                <dd class="font-mono text-3xl lg:text-4xl font-bold text-slate-900 tabular-nums leading-none">
                                    {stat.value}
                                </dd>
                                <dd class="text-sm text-slate-500 mt-2">{stat.label}</dd>
                            </div>
                        </div>
                    ))
                }
            </dl>
        </div>
    </div>
</Section>
