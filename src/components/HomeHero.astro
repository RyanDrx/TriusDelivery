---
import { type HeroSection } from 'types';
import WaveClip from '@components/WaveClip.astro';

interface Props extends HeroSection {
    'data-sb-field-path'?: string;
}

const { heading: _heading, body: _body, cta: _cta, backgroundImage: _backgroundImage, ...rest } = Astro.props;

const trustItems = [
    { label: 'TSA Verified', icon: 'heroicons:shield-check' },
    { label: 'Industry Trained', icon: 'heroicons:academic-cap' },
    { label: '24/7 STAT', live: true }
];
---

<section {...rest} class='relative min-h-[88vh] lg:min-h-[92vh] overflow-hidden text-white bg-slate-50' aria-labelledby='home-hero-heading'>
    <!-- Wave-clipped background layers: brand signature bottom wave -->
    <WaveClip side='bottom' amplitude={2} baseline={97} waves={1.25} samples={36} class='absolute inset-0'>
        <!-- Background photo -->
        <img
            src='/Images/Courier_back.webp'
            alt='Trius medical courier in the field delivering healthcare cargo'
            class='absolute inset-0 w-full h-full object-cover object-[center_55%]'
            loading='eager'
            fetchpriority='high'
            width='1920'
            height='1280'
        />

        <!-- Brand gradient washes — green-to-blue diagonal pair -->
        <div aria-hidden='true' class='absolute inset-0 bg-gradient-to-br from-primary/65 via-primary/45 to-secondary/55'></div>
        <div aria-hidden='true' class='absolute inset-0 bg-gradient-to-tr from-secondary/30 via-transparent to-primary/30 opacity-80'></div>

        <!-- Bottom-left legibility boost where the content sits -->
        <div
            aria-hidden='true'
            class='absolute inset-0 bg-[radial-gradient(ellipse_90%_70%_at_15%_88%,rgba(10,86,128,0.55),transparent_70%)]'
        >
        </div>

        <!-- Bottom safety fade -->
        <div aria-hidden='true' class='absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-primary-dark/55 to-transparent'></div>
    </WaveClip>

    <!-- Content layer -->
    <div class='relative z-10 min-h-[88vh] lg:min-h-[92vh] pb-12 lg:pb-16 flex flex-col max-w-7xl mx-auto px-6 md:px-10 lg:px-14'>
        <!-- Top: brand stamp + live mark -->
        <header class='flex items-start justify-between pt-8 lg:pt-12 animate-fade-up' style='animation-delay: 0.05s;'>
            <div class='flex items-center gap-4 md:gap-5'>
                <img
                    src='/logos/Trius_Logo.svg'
                    alt='Trius LLC - Medical Courier Services'
                    width='82'
                    height='82'
                    class='w-14 h-14 md:w-[4.25rem] md:h-[4.25rem] lg:w-20 lg:h-20 brightness-0 invert drop-shadow-[0_4px_16px_rgba(0,0,0,0.25)]'
                />
                <div>
                    <div class='font-brand font-black text-4xl md:text-3xl lg:text-[2rem] tracking-wide leading-none'>
                        TRIUS<span class='ml-2 font-medium text-white/65 text-base md:text-lg lg:text-xl align-baseline'>LLC</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Bottom: content block -->
        <div class='mt-auto pb-12 lg:pb-16 max-w-3xl'>
            <h1
                id='home-hero-heading'
                class='text-5xl md:text-6xl lg:text-7xl xl:text-[5.5rem] font-bold tracking-[-0.025em] leading-[0.95] text-white text-balance drop-shadow-[0_2px_24px_rgba(0,0,0,0.35)] animate-fade-up'
                style='animation-delay: 0.25s;'
            >
                <span class='block'>Specialized Medical</span>
                <span class='block text-secondary-light'>Courier Services</span>
            </h1>

            <p
                class='mt-7 text-base md:text-lg lg:text-xl text-white/85 leading-relaxed max-w-2xl animate-fade-up'
                style='animation-delay: 0.35s;'
            >
                Fast, reliable, and professional medical deliveries across the Pacific Northwest.
            </p>

            <div class='mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 animate-fade-up' style='animation-delay: 0.45s;'>
                <a
                    href='/contact'
                    class='group inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white text-primary-dark text-base font-bold shadow-[0_10px_30px_-8px_rgba(0,0,0,0.45)] hover:bg-secondary-light hover:text-primary-dark transition-colors duration-200 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-secondary-light/40'
                >
                    Schedule a pickup
                    <iconify-icon
                        icon='heroicons:arrow-right'
                        width='18'
                        height='18'
                        class='transition-transform duration-200 group-hover:translate-x-0.5'></iconify-icon>
                </a>

                <a
                    href='tel:+12532310615'
                    class='inline-flex items-center gap-2.5 text-sm font-medium text-white/85 hover:text-white transition-colors'
                >
                    <iconify-icon icon='heroicons:phone' width='16' height='16' class='text-white/60'></iconify-icon>
                    <span>
                        or call <span class='font-bold text-white'>(253) 231-0615</span>
                    </span>
                </a>
            </div>

            <!-- Trust strip -->
            <div class='mt-12 pt-7 border-t border-white/20 animate-fade-up' style='animation-delay: 0.55s;'>
                <div class='flex flex-wrap items-center gap-x-5 gap-y-3 text-[0.7rem] font-bold tracking-[0.18em] uppercase text-white/80'>
                    {
                        trustItems.map((item, i) => (
                            <>
                                {i > 0 && <span class='text-white/25 hidden sm:inline'>/</span>}
                                <span class='flex items-center gap-2'>
                                    {item.live ? (
                                        <span class='relative flex h-2 w-2' aria-hidden='true'>
                                            <span class='animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-70' />
                                            <span class='relative inline-flex h-2 w-2 rounded-full bg-accent' />
                                        </span>
                                    ) : (
                                        <iconify-icon icon={item.icon!} width='14' height='14' class='text-secondary-light shrink-0' />
                                    )}
                                    {item.label}
                                </span>
                            </>
                        ))
                    }
                    <span class='text-white/25 hidden sm:inline'>/</span>
                    <span>
                        Trusted by <span class='text-white font-bold'>150+</span> healthcare orgs
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes fade-up {
        0% {
            opacity: 0;
            transform: translateY(14px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-up {
        opacity: 0;
        animation: fade-up 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-fade-up {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }
</style>
