---
import { safeMarkdown } from '@utils/markdown';
import { type Footer } from 'types';

interface Props extends Footer {
    'data-sb-field-path'?: string;
}

const { text, 'data-sb-field-path': fieldPath } = Astro.props;

const navColumns = [
    {
        heading: 'Services',
        links: [
            { label: 'STAT Deliveries', href: '/services/stat-delivery' },
            { label: 'Scheduled Routes', href: '/services/scheduled-routes' },
            { label: 'Specialized Equipment', href: '/services/specialized-equipment' },
            { label: 'All Services', href: '/services' }
        ]
    },
    {
        heading: 'Company',
        links: [
            { label: 'About', href: '/about' },
            { label: 'Coverage', href: '/coverage' },
            { label: 'Contact', href: '/contact' }
        ]
    },
    {
        heading: 'Legal',
        links: [
            { label: 'Privacy Policy', href: '/privacy' },
            { label: 'Terms of Service', href: '/terms' }
        ]
    }
];

const states = ['Washington', 'Oregon', 'Idaho', 'Montana', 'Northern California'];

const microStats = [
    { label: 'Est.', value: '2022' },
    { label: 'HQ', value: 'Tacoma, WA' },
    { label: 'States', value: '5' },
    { label: 'STAT Line', value: '24/7' }
];

const year = new Date().getFullYear();
---

<footer
    class="relative bg-primary-dark text-white overflow-hidden"
    data-sb-field-path={fieldPath}
>
    <!-- Subtle deepening + brand accents -->
    <div
        aria-hidden="true"
        class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.18)_0%,rgba(0,0,0,0)_30%,rgba(0,0,0,0.25)_100%)] pointer-events-none"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-light/70 to-transparent"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute -top-40 right-0 w-[42rem] h-[22rem] bg-[radial-gradient(ellipse_at_top_right,rgba(151,204,108,0.18),transparent_70%)] pointer-events-none"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute -bottom-40 left-0 w-[42rem] h-[22rem] bg-[radial-gradient(ellipse_at_bottom_left,rgba(45,141,190,0.22),transparent_70%)] pointer-events-none"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <!-- Top: Brand + Contact prominence -->
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
            <!-- Brand block -->
            <div class="lg:col-span-5 space-y-6">
                <div class="flex items-center gap-3">
                    <img
                        src="/logos/Trius_Logo.svg"
                        alt="Trius LLC - Medical Courier Services"
                        width="36"
                        height="36"
                        class="w-9 h-9 brightness-0 invert"
                    />
                    <div>
                        <div class="font-brand font-black text-xl tracking-wide text-white leading-none">TRIUS LLC</div>
                        <div class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 mt-1.5">
                            Medical Couriers
                        </div>
                    </div>
                </div>

                <p class="text-white/80 leading-relaxed max-w-md text-[0.95rem]">
                    Healthcare-only courier service across the Pacific Northwest and Northern California. STAT specimens,
                    scheduled lab routes, and specialized equipment, handled by people trained on hospital workflows.
                </p>

                <!-- 24/7 STAT line — the prominent contact point -->
                <a
                    href="tel:+12532310615"
                    class="group inline-flex flex-col items-start gap-2 mt-2"
                >
                    <span class="inline-flex items-center gap-2 bg-accent text-white text-[0.6rem] font-mono font-bold tracking-[0.22em] uppercase px-3 py-1.5 rounded-full shadow-sm shadow-accent/30">
                        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
                            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
                        </span>
                        24/7 STAT Line
                    </span>
                    <span class="block text-2xl font-bold text-white group-hover:text-secondary-light transition-colors">
                        (253) 231-0615
                    </span>
                </a>
            </div>

            <!-- Nav columns -->
            {
                navColumns.map((col) => (
                    <nav class="lg:col-span-2" aria-label={col.heading}>
                        <h3 class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 mb-5">
                            {col.heading}
                        </h3>
                        <ul class="space-y-3">
                            {col.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-[0.95rem] text-white/80 hover:text-white transition-colors duration-150"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                ))
            }

            <!-- Secondary contact (col-span-1 grouping aside) -->
            <div class="lg:col-span-1 lg:col-start-12 lg:row-start-1 lg:hidden">
                <!-- placeholder, secondary contact rendered inline below on mobile -->
            </div>
        </div>

        <!-- Email + address row -->
        <div class="mt-12 pt-10 border-t border-white/10 grid sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12 text-sm">
            <div>
                <div class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 mb-2">Email</div>
                <a
                    href="mailto:Triusllccouriers@outlook.com"
                    class="text-white/90 hover:text-white transition-colors break-all"
                >
                    Triusllccouriers@outlook.com
                </a>
            </div>
            <div>
                <div class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 mb-2">Headquarters</div>
                <address class="text-white/90 not-italic leading-relaxed">
                    618 160th Street Ct E<br />
                    Tacoma, WA 98445
                </address>
            </div>
            <div>
                <div class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 mb-2">Hours</div>
                <p class="text-white/90">
                    Always on, 365 days a year.<br />
                    <span class="text-white/60">A real person answers.</span>
                </p>
            </div>
        </div>

        <!-- Coverage strip -->
        <div class="mt-12 pt-10 border-t border-white/10">
            <div class="flex flex-col lg:flex-row lg:items-baseline gap-3 lg:gap-6">
                <div class="text-[0.65rem] font-mono font-bold tracking-[0.22em] uppercase text-white/60 shrink-0">
                    Service Area
                </div>
                <div class="flex flex-wrap gap-x-3 gap-y-1.5 text-[0.95rem] text-white/90">
                    {
                        states.map((state, idx) => (
                            <span class="inline-flex items-center gap-3">
                                {idx > 0 && <span class="text-white/30">/</span>}
                                <span>{state}</span>
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Micro stats rail -->
        <div class="mt-10 pt-8 border-t border-white/10 flex flex-wrap gap-x-8 gap-y-3">
            {
                microStats.map((stat) => (
                    <div class="flex items-baseline gap-2">
                        <span class="text-[0.6rem] font-mono font-bold tracking-[0.22em] uppercase text-white/55">
                            {stat.label}
                        </span>
                        <span class="text-sm font-bold text-white/90 tabular-nums font-mono">{stat.value}</span>
                    </div>
                ))
            }
        </div>

        <!-- Optional CMS text -->
        {
            text && (
                <div
                    class="mt-10 text-sm text-white/80 prose prose-invert max-w-none"
                    data-sb-field-path=".text"
                    set:html={safeMarkdown(text)}
                />
            )
        }
    </div>

    <!-- Bottom bar -->
    <div class="relative border-t border-white/10 bg-black/15">
        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/55">
            <div class="text-center sm:text-left">
                <span>&copy; {year} Trius LLC.</span>
                <span class="mx-1.5 text-white/25">/</span>
                <span>All rights reserved.</span>
            </div>

            <a
                href="https://rndtnd.com"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 text-white/55 hover:text-white/90 transition-colors duration-200"
            >
                <span class="font-medium">Crafted by</span>
                <span class="font-semibold tracking-wide text-white/60 group-hover:text-white transition-colors">
                    RND_TND
                </span>
                <iconify-icon
                    icon="heroicons:arrow-up-right"
                    width="12"
                    height="12"
                    class="opacity-60 group-hover:opacity-100 group-hover:-translate-y-px transition-all"
                />
            </a>
        </div>
    </div>
</footer>
